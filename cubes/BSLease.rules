#Region OLD Currency Conversion
# ['AUD-MonthEnd'] = N:['Local'] / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,!Currency,'Currency','FXRate');
# ['AUD-Budget'] = N:['Local'] / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,!Currency,'Currency','FXRate');
# ['AUD-Constant'] = N:['Local'] / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,!Currency,'Currency','FXRate');
# ['AUD-Outlook'] = N:['Local'] / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,!Currency,'Currency','FXRate');
# ['USD-Constant'] = N:['Local'] / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,!Currency,'Currency','FXRate');
# ['EUR-Budget'] = N:['Local'] / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,!Currency,'Currency','FXRate');
# ['USD-Budget'] = N:['Local'] / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,!Currency,'Currency','FXRate');
# ['Constant'] = N:['Local'] / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,!Currency,'Currency','FXRate');

#EndRegion

FEEDERS ;

#Region Currency Conversion
 ['Local'] => ['EUR-Constant'];
 ['Local'] => ['EUR-Budget'];
 ['Local'] => ['AUD-MonthEnd'];
 ['Local'] => ['AUD-Budget'];
 ['Local'] => ['Constant'];
 ['Local'] => ['AUD-Constant'];
 ['Local'] => ['AUD-Outlook'];
 ['Local'] => ['USD-Constant'];
 ['Local'] => ['USD-Budget'];


#EndRegion

#Region Internal Feeders
['BSComponent':{'Override','Total'}] => 
  ['BSComponent':'Reported Value'];
  
['BSComponent':'Calculated'] => 
  ['BSComponent':'Total'];  
  
['Actual', 'Lease Repayment','Override', 'Local']=>
  ['B/Fwd Liability', 'Calculated', 'Outlook'],
  ['C/Fwd Liability', 'Calculated', 'Outlook'],
  ['B/Fwd RoU Asset', 'Calculated', 'Outlook'],  
  ['C/Fwd RoU Asset', 'Calculated', 'Outlook'],
  ['Interest Expense', 'Calculated', 'Outlook'],
  ['Lease Repayment', 'Calculated', 'Outlook'],  

  ['B/Fwd Liability', 'Calculated', 'Working Budget'],
  ['C/Fwd Liability', 'Calculated', 'Working Budget'],
  ['B/Fwd RoU Asset', 'Calculated', 'Working Budget'],  
  ['C/Fwd RoU Asset', 'Calculated', 'Working Budget'],
  ['Interest Expense', 'Calculated', 'Working Budget'],
  ['Lease Repayment', 'Calculated', 'Working Budget'];

['Actual', 'Override', 'Lease Repayment','Local']=>
  ['Working Budget', 'Calculated','Lease Repayment', 'Local'];
  
[{'Working Budget','Outlook'}, 'C/Fwd Liability', 'Calculated']=>
  ['Calculated','Current Lease Liability','Calculated'];

#== BS Lease Repayment
[{'Working Budget','Outlook'},'Lease Repayment'] => 
  ['PV Monthly Lease Payment'];

['B/Fwd RoU Asset'] => 
  ['Dep''n Charge'];

['PV Monthly Lease Payment'] => 
  ['PV Monthly Lease Payment Cumsum'];
  
['PV Monthly Lease Payment Cumsum'] => 
  ['B/Fwd Liability'];

['PV Monthly Lease Payment Cumsum'] => 
  DB('BSLease', !BusinessUnit, !Currency, !BSComponent, !BSLeaseLocation, 
  Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'PV Monthly Lease Payment Cumsum');

['C/Fwd Liability' ] =>
  DB('BSLease', !BusinessUnit, !Currency, !BSComponent, !BSLeaseLocation, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'B/Fwd Liability');

['B/Fwd Liability'] => ['Interest Expense'];

[{'Lease Repayment','Interest Expense'}] => ['Principal'];

[{'B/Fwd Liability','Principal'}] => ['C/Fwd Liability'];

['B/Fwd Liability'] => ['B/Fwd RoU Asset'];
['C/Fwd RoU Asset' ] =>
DB('BSLease', !BusinessUnit, !Currency, !BSComponent, !BSLeaseLocation, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'B/Fwd RoU Asset');

['B/Fwd RoU Asset' ] =>
DB('BSLease', !BusinessUnit, !Currency, !BSComponent, !BSLeaseLocation, DB( 'BSLeaseStart', !BSLeaseLocation, 'Start Month for B/Fwd Liability' ), !Version, 'Dep''n Charge');

[{'B/Fwd RoU Asset','Dep''n Charge'}] => ['C/Fwd RoU Asset'];

#== BS Lease
['RoU Closing balance'] =>
DB('BSLease', !BusinessUnit, !Currency, !BSComponent, !BSLeaseLocation, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'RoU Opening balance');

[{'RoU Opening balance','Depreciation'}] => ['RoU Closing balance'];

['Lease Liability - Current Closing balance'] => 
DB('BSLease', !BusinessUnit, !Currency, !BSComponent, !BSLeaseLocation, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'Lease Liability - Current Opening balance');

['Lease Repayment'] => ['Lease Repayment (-)'];

[{'Current Lease Liability','Lease Liability - Current Opening balance','Interest Expense','Lease Repayment (-)'}] => ['Reclass non-current portion'];

[{'Lease Liability - Current Opening balance','Interest Expense','Lease Repayment (-)','Reclass non-current portion'}] => ['Lease Liability - Current Closing balance'];

['Lease Liability - Non-current Closing balance'] => 
DB('BSLease', !BusinessUnit, !Currency, !BSComponent, !BSLeaseLocation, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'Lease Liability - Non-current Opening balance');

['Reclass non-current portion'] => ['Reclass non-current portion (-)'];

[{'Lease Liability - Non-current Opening balance','Reclass non-current portion (-)'}] => ['Lease Liability - Non-current Closing balance'];

[{'Lease Liability - Current Closing balance','Lease Liability - Non-current Closing balance'}] => ['Total lease liability'];

[{'Total lease liability','C/Fwd Liability'}] => ['Check to leases summary'];
#EndRegion

#Region External Feeders
#== BS Capex
['BSLeaseMeasure':'Depreciation'] => 
DB('BSStgCapex', !BusinessUnit, !Currency,  'BSComponent':'Reported Value', !BSLeaseLocation, !FiscalMonth, !Version, 'BSStgCapexMeasure':'Depreciation');

#== BS PPE
['BSLeaseMeasure':'Dep''n Charge','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version,  'BSComponent':'Calculated', 'BSStgStagingMeasure':'Right of use asset'),
DB('BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, '110600', !BSComponent, 'Movement' );

#== BS Lease (B/Fwd Liability)
['BSLeaseMeasure':'B/Fwd Liability','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'B/Fwd Liability');

['BSLeaseMeasure':'B/Fwd Liability','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'B/Fwd Liability');

#== BS Lease (Interest Expense)
['BSLeaseMeasure':'Interest Expense','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'Interest Expense');

['BSLeaseMeasure':'Interest Expense','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'Interest Expense');

#== BS Lease (Lease Repayment)
['BSLeaseMeasure':'Lease Repayment','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'Lease Repayment');

['BSLeaseMeasure':'Lease Repayment','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'Lease Repayment');

#== BS Lease (Principal)
['BSLeaseMeasure':'Principal','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'Principal');

['BSLeaseMeasure':'Principal','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'Principal');

#== BS Lease (C/Fwd Liability)
['BSLeaseMeasure':'C/Fwd Liability','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'C/Fwd Liability');

['BSLeaseMeasure':'C/Fwd Liability','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'C/Fwd Liability');

#== BS Lease (B/Fwd RoU Asset)
['BSLeaseMeasure':'B/Fwd RoU Asset','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'B/Fwd RoU Asset');

['BSLeaseMeasure':'B/Fwd RoU Asset','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'B/Fwd RoU Asset');

#== BS Lease (Dep'n Charge)
['BSLeaseMeasure':'Dep''n Charge','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'Dep''n Charge');

['BSLeaseMeasure':'Dep''n Charge','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'Dep''n Charge');

#== BS Lease (C/Fwd RoU Asset)
['BSLeaseMeasure':'C/Fwd RoU Asset','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'C/Fwd RoU Asset');

['BSLeaseMeasure':'C/Fwd RoU Asset','Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget',  'BSComponent':'Calculated', 'BSStgStagingMeasure':'C/Fwd RoU Asset');

#== BS Lease (Lease Calculation)

['Reported Value','BSLeaseLocation':'Total','Actual', 'Dep''n Charge'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Depreciation');
['Reported Value','BSLeaseLocation':'Total','Actual', 'Dep''n Charge'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Depreciation');

['Reported Value','BSLeaseLocation':'Total','Actual', {'C/Fwd Liability','Interest Expense','Lease Repayment'}] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Reclass non-current portion');
['Reported Value','BSLeaseLocation':'Total','Actual', {'C/Fwd Liability','Interest Expense','Lease Repayment'}] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Reclass non-current portion');
['Reported Value','BSLeaseLocation':'Total','Actual', 'C/Fwd Liability'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, Attrs('FiscalMonth', !FiscalMonth, 'PYPeriod'), 'Outlook', 'Calculated', 'Reclass non-current portion');
['Reported Value','BSLeaseLocation':'Total','Actual', 'C/Fwd Liability'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, Attrs('FiscalMonth', !FiscalMonth, 'PYPeriod'), 'Working Budget', 'Calculated', 'Reclass non-current portion');
#EndRegion

#['Override','BSLeaseLocation':'Total','Actual', 'C/Fwd Liability'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Reported Value', 'Check to leases summary');
