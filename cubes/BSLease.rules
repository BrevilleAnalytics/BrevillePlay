#    , (DB('BSLeaseAssump', !BusinessUnit, !Currency, !BSLeaseLocation, SUBST ( DIMNM( 'FiscalMonth' , DIMIX('FiscalMonth' , !FiscalMonth) ), 1 , 4 ), !Version, 'Annual')
#      * DB('BSLeaseAssump', !BusinessUnit, !Currency, !BSLeaseLocation, SUBST ( DIMNM( 'FiscalMonth' , DIMIX('FiscalMonth' , !FiscalMonth) ), 1 , 4 ), !Version, 'Discount'))\12
