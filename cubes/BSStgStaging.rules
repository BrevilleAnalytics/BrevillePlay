      ['Intangible Assets - Software - CB','Reported Value',{'Outlook','Working Budget'}] =>
      DB('BSStgStaging' ,!BusinessUnit, !Currency, AttrS('FiscalMonth',!FiscalMonth,'NextPeriod'), !Version, 'Calculated', 'Intangible Assets - Software - OB'),
      DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version, 'Calculated', 'Intangible Accum Depn - Software - OB'),
