  DB('BSStgStaging' ,!BusinessUnit, !Currency, AttrS('FiscalMonth',!FiscalMonth,'NextPeriod'), !Version, 'Calculated', 'Intangible Assets - Other - CB'),
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version, 'Calculated', 'Intangible Assets - Other - CB');

  [BSStgStagingMeasure:'BSStgStagingMeasure':'Intangible Assets - Other - Depn','Reported Value',{'Outlook','Working Budget'}] =>
