  [BSStgStagingMeasure:'BSStgStagingMeasure':'Intangible Assets - Development costs - OB','Reported Value',{'Outlook','Working Budget'}] =>
  DB('BSStgStaging' ,!BusinessUnit, !Currency, AttrS('FiscalMonth',!FiscalMonth,'NextPeriod'), !Version, 'Calculated', 'Intangible Assets - Development costs - CB'),
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version, 'Calculated', 'Intangible Assets - Development costs - CB');

  [BSStgStagingMeasure:'BSStgStagingMeasure':'Intangible Assets - Development costs - Depn','Reported Value',{'Outlook','Working Budget'}] =>
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version, 'Calculated', 'Intangible Accum Depn - Development costs - CB'),
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version, 'Calculated', 'Intangible Accum Depn - Development costs - OB')  ;

  ['Tooling - OB','Reported Value',{'Outlook','Working Budget'}] =>
  DB('BSStgStaging' ,!BusinessUnit, !Currency, AttrS('FiscalMonth',!FiscalMonth,'NextPeriod'), !Version, 'Calculated', 'Tooling - CB'),
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version, 'Calculated', 'Tooling - CB');

  [BSStgStagingMeasure:'BSStgStagingMeasure':'Tooling - Depn','Reported Value',{'Outlook','Working Budget'}] =>
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version, 'Calculated', 'Tooling - Accum Depn - CB'),
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version, 'Calculated', 'Tooling - Accum Depn - OB')  ;

      ['Plant & Equipment - CB','Reported Value',{'Outlook','Working Budget'}] =>
