#Region== BS Inventory
  ['Closing Inventory (ex provision)','Reported Value',{'Outlook','Working Budget'}] =>
  DB('BSStgStaging' ,!BusinessUnit, !Currency, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'Calculated', 'Opening Inventory');

  [{'Closing Inventory (ex provision)','Opening Inventory','Less Cost of Sales (per Outlook)'}] =>
  ['Add Purchases', 'Calculated'];

  ['BAU (AUD)  VG Transfers','Reported Value',{'Outlook','Working Budget'}] =>
  ['Less Transfers to NZ (per VG)', 'Calculated'];

  [{'Opening Inventory','Add Purchases','COGS FX amortised to P&L','Less Cost of Sales (per Outlook)','Less Transfers to NZ (per VG)'},'Calculated',{'Outlook','Working Budget'}] =>
  ['Closing Inventory (ex provision)', 'Calculated'],
  ['Provision', 'Calculated'];

  ['Stock In','Reported Value',{'Outlook','Working Budget'}] =>
  ['BAU (AUD)  VG Transfers', 'Calculated'];
  #EndRegion

#Region== BS InterCo

['Net Sales per Consol Outlook','Reported Value',{'Outlook','Working Budget'}] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, !Version, 'Calculated', '3 % of Net Sales');

['Net Sales per Consol Outlook','Reported Value',{'Outlook','Working Budget'}] =>
  ['Opening Balance - VLF'],['Closing Balance - VLF'];

['20% of VLF - Paid','Reported Value',{'Outlook','Working Budget'}] =>
  ['Opening Balance - VLF'],
  ['Closing Balance - VLF'],
  DB('BSStgStaging', 'BAU', !Currency, !FiscalMonth, !Version, 'Calculated', '20% of VLF - Received' ),
  DB('BSStgStaging', 'BAU', !Currency, !FiscalMonth, !Version, 'Calculated', '80% of VLF - Received' );

[{'EBIT per Outlook','3 % of Net Sales'},'Reported Value',{'Outlook','Working Budget'}] =>
  ['VLF for the Month', 'Calculated'];

['VLF for the Month','Reported Value',{'Outlook','Working Budget'}] =>
  ['80% of VLF prepaid', 'Calculated'];

['80% of VLF prepaid','Reported Value',{'Outlook','Working Budget'}] =>
['Cash Payment', 'Calculated'],
['80% of VLF - Paid', 'Calculated'],
['Other VLF', 'Calculated'];

['VLF for the Month','Reported Value',{'Outlook','Working Budget'}] =>
  ['20% of VLF prepaid', 'Calculated'];

['20% of VLF prepaid','Reported Value',{'Outlook','Working Budget'}] =>
['Payment before chargebacks', 'Calculated'],
['20% of VLF - Paid', 'Calculated'];

['Payment before chargebacks','Reported Value',{'Outlook','Working Budget'}] =>
  ['Cash Payment after chargebacks', 'Calculated'];

['Average chargebacks','Reported Value',{'Outlook','Working Budget'}] =>
  ['Cash Payment after chargebacks', 'Calculated'];

['VLF for the Month','Reported Value',{'Outlook','Working Budget'}] =>
  ['Total WHT', 'Calculated'];

['Opening Balance - VLF','Reported Value',{'Outlook','Working Budget'}] =>
  ['Closing Balance - VLF', 'Calculated'];

['Net stock transfers',{'Outlook','Working Budget'},'Calculated' ] =>
  ['Net stock transfers - cash settlement'];

['Closing Balance - VLF','Reported Value',{'Outlook','Working Budget'}] =>
  DB('BSStgStaging' ,!BusinessUnit, !Currency, AttrS('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'Calculated', 'Opening Balance - VLF');

['Lelit VLF - (Cash)']=>
  ['Lelit VLF - (Invoiced)'],
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Calculated', 'Lelit VLF - (Cash)' );

['Other 1 - (Cash)']=>
  ['Other 1 - (Invoiced)'],
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Calculated', 'Other 1 - (Cash)' );

['Other 2 - (Cash)']=>
  ['Other 2 - (Invoiced)'],
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Calculated', 'Other 2 - (Cash)' );
#EndRegion

#Region== BS Lease

['C/Fwd Liability']=>
  DB('BSStgStaging', !BusinessUnit, !Currency, AttrS('FiscalMonth',!FiscalMonth,'PrevPeriod'), !Version, !BSComponent, 'B/Fwd Liability' );

['RoU Closing balance',{'Outlook','Working Budget'},'Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'Calculated', 'RoU Opening balance');
['Right of use asset',{'Outlook','Working Budget'},'Reported Value'] => ['Depreciation', 'Calculated'];
[{'RoU Opening balance','Depreciation'},{'Outlook','Working Budget'},'Reported Value'] => ['RoU Closing balance', 'Calculated'];

#= Lease Liability - Current Opening balance
['Lease Liability - Current Closing balance',{'Outlook','Working Budget'},'Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'Calculated', 'Lease Liability - Current Opening balance');

['Lease Liability - Current Opening balance',{'Outlook','Working Budget'},'Reported Value'] =>
['Reclass non-current portion', 'Calculated'],['Lease Liability - Current Closing balance', 'Calculated'];

['Reclass non-current portion',{'Outlook','Working Budget'},'Reported Value'] =>
['Lease Liability - Current Closing balance', 'Calculated'],
['C/Fwd Liability', 'Calculated']  ;

#= Lease Liability - Non-current Opening balance
['Lease Liability - Non-current Closing balance',{'Outlook','Working Budget'},'Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'Calculated', 'Lease Liability - Non-current Opening balance');
['Reclass non-current portion',{'Outlook','Working Budget'},'Reported Value'] => ['Reclass non-current portion (-)', 'Calculated'];
[{'Reclass non-current portion (-)','Lease Liability - Non-current Opening balance' },{'Outlook','Working Budget'},'Reported Value'] => ['Lease Liability - Non-current Closing balance', 'Calculated'];
[{'Lease Liability - Non-current Closing balance','Lease Liability - Current Closing balance' },{'Outlook','Working Budget'},'Reported Value'] => ['Total lease liability', 'Calculated'];
['Total lease liability',{'Outlook','Working Budget'},'Reported Value'] => ['Check to leases summary', 'Calculated'];
#EndRegion

#=Accrued marketing
['Accrued Marketing',{'Outlook','Working Budget'},'Reported Value'] =>
DB('BSStgStaging' ,!BusinessUnit, !Currency, Attrs('FiscalMonth', !FiscalMonth, 'NextPeriod'), !Version, 'Calculated', 'Accrued Marketing');

