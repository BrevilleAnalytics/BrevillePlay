SKIPCHECK;

#Region - Rule #1 Override Calculated
['Reported Value'] = N:
  IF (DB( 'BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Override', !'BS Measure') <> 0,
     DB( 'BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Override', !'BS Measure'),
     DB( 'BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Total', !'BS Measure')  
     );
#EndRegion

#Region Dividends paid from Cashflow
  [ 'GLAccount':'300706', 'Calculated', 'Movement']=N:
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Reported Value', 'Dividend income/(payment)' );
#EndRegion

#Region - Current Period - 3 Way Adjustments
          # New measure
# ['Calculated', {'Outlook','Working Budget'}, 'Current Period - 3 Way Adjustments', 'Movement']=N:
#     IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,
