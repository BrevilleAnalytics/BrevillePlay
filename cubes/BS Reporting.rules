#EndRegion

#Region - Intercompany

[ 'GLAccount':'104001', 'Calculated', 'Movement']=N:
    IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,
  DB('BSStgStaging', !BusinessUnit, !Currency, !FiscalMonth, !Version, 'Reported Value', 'BSStgStagingMeasure':'Closing Balance - VLF')-
  DB('BS Reporting', !Version, Attrs('FiscalMonth', !FiscalMonth, 'PrevPeriod'), !Currency, !BusinessUnit, 'GLAccount':'Inter-company receivables (current) - BS', 'Reported Value', 'Balance' ),CONTINUE);  


#EndRegion

#Region - Current Period Earnings
          # Changed to Current Period Earnings per business requirement
          # Added logic to convert BHK Local currency from USD (PnL PLan) to HKD (based on AUD-Outlook)
          
[ 'GLAccount':'Current Period Earnings', 'Calculated', 'Movement', 'Local', 'BHK']=N:
   DB('PnLPlan', 'Profit After Tax', 'All Functions', !BusinessUnit, 'All Segment', 'Total', !Currency, !FiscalMonth, !Version, 'All Theatre', 'Amount' )  
 / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,'AUD-Outlook','Currency','FXRate')
 * DB('BRExchangeRate','HKT',!FiscalMonth,'AUD-Outlook','Currency','FXRate');
          
[ 'GLAccount':'Current Period Earnings', 'Calculated', 'Movement']=N:
   DB('PnLPlan', 'Profit After Tax', 'All Functions', !BusinessUnit, 'All Segment', 'Total', !Currency, !FiscalMonth, !Version, 'All Theatre', 'Amount' ) ;        
      
[ 'GLAccount':'Current Period Earnings', 'Calculated', 'Balance']=N:
      IF ( AttrS ('FiscalMonth',!FiscalMonth, 'Short_Text')@= 'Jul',
        DB('BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement' ), 
        
        DB('BS Reporting', !Version, AttrS('FiscalMonth',!FiscalMonth,'PrevPeriod'), !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Balance' )+
        DB('BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement' ));

#EndRegion        

#Region - Carry forward balances from Actual to Forecast periods

#Region - Movement and Balance for non actual periods 
        #If not part of staging cube models then bring forward actuals balance
[ 'Calculated', {'Outlook','Working Budget'}, {'Balance'}]=N:
      DB('BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement' )+
      DB('BS Reporting', !Version, AttrS('FiscalMonth',!FiscalMonth,'PrevPeriod'), !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Balance' );

#EndRegion

#Region G.S.T. / V.A.T. payables - BS
# [ {'Outlook','Working Budget'} , 'G.S.T. / V.A.T. payables - BS', {'Calculated','Reported Value'}, 'Balance' ] =  C:
#   IF ( ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'BSReporting' ), !FiscalMonth , 'Actual Flag' ) <> 1
#     # %  ( ELLEV ('BusinessUnit', !BusinessUnit) <> 0 ) 
#         ), 
#        DB('BSStgStaging', !BusinessUnit, !Currency, !FiscalMonth, !Version, 'Reported Value', 'GST payable/(receivable)' ),
#        # ['GST/VAT/QST receivable - BS'],
#        # DB('BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'GST/VAT/QST receivable - BS', !BSComponent, !BS Measure ),
# 	   CONTINUE);
#EndRegion

FEEDERS;

#Region Override 
[{'Override','Total'}]=> 
  ['Reported Value'];
  
['Calculated']=> 
  ['Total'];
#EndRegion
  
[ 'Current Period Earnings', 'Calculated']=>
  [ 'Current Period Earnings', 'Total'];
 
['Movement']=> 
  ['Balance'];

[ 'Calculated', {'Outlook','Working Budget'}, 'Balance'] =>
 DB('BS Reporting', !Version, AttrS('FiscalMonth',!FiscalMonth,'NextPeriod'), !Currency, !BusinessUnit, !GLAccount, !BSComponent, !BS Measure );  

[GLAccount:'GLAccount':'All BalanceSheet GLAccounts']=>
  ['Current Period Earnings'];

['300701']=>
  ['Current Period Earnings'];  
  
#Region - Trade Payables including GRNI
['GLAccount':'GLAccount':'Trade payables - BS']=>
['201001'],
['GLAccount':'GLAccount':'Trade payables - GRNI - BS'];

['GLAccount':'GLAccount':'Trade & other payables - BS']=>
DB('BS Reporting', !Version, AttrS('FiscalMonth',!FiscalMonth,'NextPeriod'), !Currency, !BusinessUnit, !GLAccount, !BSComponent, !BS Measure );   

['GLAccount':'GLAccount':'Trade payables - GRNI - BS']=>
['201001'];
#EndRegion

#Region - Trade Receivables
['GLAccount':'GLAccount':'Trade receivables - BS']=>
['101001'];
#EndRegion

#Region - Lease Liabilities (Current and Non Current)
['GLAccount':'GLAccount':'Lease liabilities (current) - BS']=>
['200201'];

['GLAccount':'GLAccount':'Lease liabilities (non-current) - BS']=>
['211200'];


[FiscalMonth:'FiscalMonth':'2024011', 'Balance']=>
  [FiscalMonth:'FiscalMonth':'2024012', 'Balance'];
  
#EndRegion

#Region - CF Reporting

['GLAccount':'GLAccount':'All BalanceSheet GLAccounts', 'Balance']=>
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !BSComponent, 'All Measures');


#EndRegion

['Goods in transit (at cost) - BS']=>
  DB('BSStgStaging', !BusinessUnit, !Currency, !FiscalMonth, !Version, !BSComponent,'Goods in Transit' );

[{'Outlook','Working Budget'}, 'GLAccount':'GLAccount':'Cash advance facilities (current) - BS', 'Balance']=>
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Reported Value', 'Closing balance - Borrowings');

[{'Outlook','Working Budget'}, 'GLAccount':'GLAccount':'Cash advance facilities (non-current) - BS', 'Balance']=>
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Reported Value', 'Closing Balance - Borrowings (non-current)');