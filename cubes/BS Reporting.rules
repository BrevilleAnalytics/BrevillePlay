#         DB('BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement' );
#EndRegion

#Region - Current Period - Intercompany
          # New measure
          # Added logic to convert BHK Local currency from USD (PnL PLan) to HKD (based on AUD-Outlook)
          
# [ 'GLAccount':'Current Period – Intercompany', 'Calculated', 'Movement', 'Local', 'BHK']=N:
#    (DB('BSStgActuals', 'GLAccount':'Gross Sales', !BusinessUnit, !Currency, !FiscalMonth, 'Reported Value', 'Balance')+
#    DB('BSStgActuals', 'GLAccount':'COGS', !BusinessUnit, !Currency, !FiscalMonth, 'Reported Value', 'Balance'))
#  / DB('BRExchangeRate',!BusinessUnit,!FiscalMonth,'AUD-Outlook','Currency','FXRate')
#  * DB('BRExchangeRate','HKT',!FiscalMonth,'AUD-Outlook','Currency','FXRate');

# [ 'GLAccount':'Current Period – Intercompany', 'Calculated', 'Movement']=N:
#     IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,        
#         (DB('BSStgStaging', !BusinessUnit, !Currency, !FiscalMonth, !Version, !BSComponent, 'VLF for the Month' ) *-1),0);

# [ 'GLAccount':'Current Period – Intercompany', 'Calculated', 'Movement']=N:
#       # IF ( AttrS ('FiscalMonth',!FiscalMonth, 'Short_Text')@= 'Jul',
#       #   DB('BSStgStaging', !BusinessUnit, !Currency, !FiscalMonth, !Version, !BSComponent, 'VLF for the Month' )*-1, 
#     IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,        
#         (DB('BSStgStaging', !BusinessUnit, !Currency, !FiscalMonth, !Version, !BSComponent, 'VLF for the Month' )-
#         DB('BSStgStaging', !BusinessUnit, !Currency, AttrS('FiscalMonth',!FiscalMonth,'PrevPeriod'), !Version, !BSComponent, 'VLF for the Month' )) *-1,0
#    )
#   ;
      
[ 'GLAccount':'Current Period – Intercompany', 'Calculated', 'Balance']=N:
      # IF ( AttrS ('FiscalMonth',!FiscalMonth, 'Short_Text')@= 'Jul',
      #   DB('BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement' ), 
    IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,         
        DB('BS Reporting', !Version, AttrS('FiscalMonth',!FiscalMonth,'PrevPeriod'), !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Balance' )+
        DB('BS Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement' ),0);

#EndRegion 

#Region - Bring in Movement and Balance from BSStgActuals cube for actual data
[ 'Calculated', {'Outlook','Working Budget'}, {'Balance','Movement'}]=N:
  IF( 
    DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) = 1 & !GLAccount @<> 'Current Period Earnings',
    DB('BSStgActuals', !GLAccount, !BusinessUnit, !Currency, !FiscalMonth, !BSComponent, !BS Measure),
    CONTINUE
    ) ;
#EndRegion 

#Region - Cash Closing Balance from CF Reporting cube
[ 'Calculated', {'Outlook','Working Budget'}, {'Movement'}, '100110']=N:
IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Reported Value', 'Closing balance' )-
  DB('BS Reporting', !Version, Attrs('FiscalMonth', !FiscalMonth, 'PrevPeriod'), !Currency, !BusinessUnit, 'GLAccount':'Cash at bank - BS', 'Reported Value', 'Balance' )  
  ,CONTINUE);

[ 'GLAccount':'105001', 'Calculated', 'Movement']=N:
    IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,
  DB('BSStgStaging', !BusinessUnit, !Currency, !FiscalMonth, !Version, 'Reported Value', 'BSStgStagingMeasure':'Closing Inventory (ex provision)')-
  DB('BS Reporting', !Version, Attrs('FiscalMonth', !FiscalMonth, 'PrevPeriod'), !Currency, !BusinessUnit, 'GLAccount':'Finished goods (at lower cost) - BS', 'Reported Value', 'Balance' ),CONTINUE);  

#EndRegion

#Region - Cash advances from CF Reporting cube
[ 'Calculated', {'Outlook','Working Budget'}, {'Movement'}, '200110']=N:
IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Reported Value', 'Drawdown' )+
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Reported Value', 'Repayment' )  
  ,CONTINUE);

[ 'Calculated', {'Outlook','Working Budget'}, {'Balance'}, '200110']=N:
  ['Movement'] + DB('BS Reporting', !Version, AttrS('FiscalMonth', !FiscalMonth,'PrevPeriod'), !Currency, !BusinessUnit, !GLAccount, !BSComponent, !BS Measure );

#Region - Cash advances Facilities (current) from CF Reporting cube
[ 'Calculated', {'Outlook','Working Budget'}, {'Balance'}, '200185']=N:
IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Reported Value', 'Closing balance - Borrowings' ) 
  ,CONTINUE);
#Feeder required

#Region - Cash advances Facilities (non-current) from CF Reporting cube
[ 'Calculated', {'Outlook','Working Budget'}, {'Balance'}, '210101']=N:
IF ( DB( 'BRAsFiscalMonth' , 'Actual' , ATTRS( 'BusinessUnit', !BusinessUnit , 'OPXTheatre' ), !FiscalMonth , 'Actual Flag' ) <> 1,
  DB('CF Reporting', !Version, !FiscalMonth, !Currency, !BusinessUnit, 'Reported Value', 'Closing Balance - Borrowings (non-current)' ) 
  ,CONTINUE);
#Feeder required

#Region - Warranty Provisions
#Movement
[ 'GLAccount':'205504', 'Calculated', 'Movement']=N:
  DB('BSStgStaging', !BusinessUnit, !Currency, !FiscalMonth, !Version, 'Reported Value', 'Warranty Expense')+
  DB('BSStgStaging', !BusinessUnit, !Currency, !FiscalMonth, !Version, 'Reported Value', 'Warranty Claims'); 

# #Balance forecast periods
[ 'GLAccount':'205504', 'Calculated', {'Outlook','Working Budget'}, 'Balance']=N:
