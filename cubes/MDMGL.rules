 ['Parent Level 1'] = S:
 If ( DB( 'MDMGL', ELPAR( 'GLAccount' ,!GLAccount, 1 ) , 'Parent Level 1' ) @<> '' ,
 	DB( 'MDMGL', ELPAR( 'GLAccount' ,!GLAccount, 1 ) , 'Parent Level 1' ) ,
 	STET) ;

