  DB('BSStgStaging', !From Business Unit, 'USD-Constant', !FiscalMonth, !Version, 'Calculated', 'Stock Out' ),
  DB('BSStgStaging', !To Business Unit, 'USD-Constant', !FiscalMonth, !Version, 'Calculated', 'Stock In' ),
