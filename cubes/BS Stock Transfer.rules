['Transfer $']=>
  DB('BSStgStaging', !From Business Unit, 'Constant', !FiscalMonth, !Version, 'Calculated', 'Stock In' ),
  DB('BSStgStaging', !From Business Unit, 'Constant', !FiscalMonth, !Version, 'Calculated', 'Stock Out' ),
  DB('BSStgStaging', !To Business Unit, 'Constant', !FiscalMonth, !Version, 'Calculated', 'Stock In' ),
  DB('BSStgStaging', !To Business Unit, 'Constant', !FiscalMonth, !Version, 'Calculated', 'Stock Out' )
