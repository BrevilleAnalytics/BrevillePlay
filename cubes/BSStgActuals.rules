['GLAccount':'GLAccount':'202005','BSComponent':'Reported Value', 'Balance'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Accrued Marketing');
['GLAccount':'GLAccount':'202005','BSComponent':'Reported Value', 'Balance'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Accrued Marketing');

['GLAccount':'GLAccount':'111001','BSComponent':'Reported Value', 'Balance'] => 
