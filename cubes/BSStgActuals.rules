#Region System
FEEDSTRINGS;
SKIPCHECK;
#EndRegion

# Cube name: BSStgActuals
# Description: Staging cube to store actual data.


#Currency Conversion Rules
[Currency:'Currency':'AUD-Constant'] = N: ['Local']\ DB('BRExchangeRate', !BusinessUnit, !FiscalMonth,'Constant', 'Currency', 'FXRate' );
['AUD-Budget'] = N: ['Local']\ DB('BRExchangeRate', !BusinessUnit, !FiscalMonth,'AUD-Budget', 'Currency', 'FXRate' );
# ['AUD-MonthEnd'] = N: ['Local']\ DB('BRExchangeRate', !BusinessUnit, !FiscalMonth,'AUD-MonthEnd', 'Currency', 'FXRate' );
# [Currency:'Currency':'AUD-Outlook'] = N: ['Local']\ DB('BRExchangeRate', !BusinessUnit, !FiscalMonth,'AUD-Outlook', 'Currency', 'FXRate' );


['Reported Value', {'Movement', 'Balance'}] = N:
  If (DB('BSStgActuals' ,!GLAccount, !BusinessUnit, !Currency, !FiscalMonth,'Override', !BSStgActualsMeasure) <> 0,
  DB('BSStgActuals' ,!GLAccount, !BusinessUnit, !Currency, !FiscalMonth,'Override', !BSStgActualsMeasure),
  DB('BSStgActuals' ,!GLAccount, !BusinessUnit, !Currency, !FiscalMonth,'Total', !BSStgActualsMeasure) );  
 
FEEDERS ;
 
#Region=== Internal Feeders 
[{'Override','Total'}] => ['Reported Value']; 
#EndRegion

#Region BSStgStaging

    #= BS Plant & Equipment
    ['GLAccount':'GLAccount':'Plant & equipment - BS','Balance', 'Reported Value'] => 
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Plant & Equipment - OB'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Plant & Equipment - OB');

    ['GLAccount':'GLAccount':'Plant & equipment - BS','Movement', 'Reported Value'] => 
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Plant & Equipment - Additions'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Plant & Equipment - Additions');

    #= BS Tooling
    ['GLAccount':'GLAccount':'Tooling - BS','Balance', 'Reported Value'] => 
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Tooling - OB'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Tooling - OB');

    ['GLAccount':'GLAccount':'Tooling - BS','Movement', 'Reported Value'] => 
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Tooling - Additions'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Tooling - Additions');

    #= BS Intangible Assets - Development Costs
    ['GLAccount':'GLAccount':'Intangible assets - Development costs - BS','Balance', 'Reported Value'] => 
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Intangible assets - Development costs - OB'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Intangible assets - Development costs - OB');

    ['GLAccount':'GLAccount':'Intangible assets - Development costs - BS','Movement', 'Reported Value'] => 
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Intangible assets - Development costs - Additions'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Intangible assets - Development costs - Additions');  

    #= BS Intangible Assets - Goodwill
    ['GLAccount':'GLAccount':'Intangible assets - Good will - BS','Balance', 'Reported Value'] => 
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Intangible assets - Goodwill - OB'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Intangible assets - Goodwill - OB');

    #= BS Intangible Assets - Other
    ['GLAccount':'GLAccount':'Intangible assets - Other - BS','Balance', 'Reported Value'] => 
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Intangible assets - Other - OB'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Intangible assets - Other - OB');

    ['GLAccount':'GLAccount':'Computer software (gross carrying amount) - BS','Balance', 'Reported Value'] =>   
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Intangible assets - Software - OB'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Intangible assets - Software - CB'),  
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Intangible assets - Software - OB'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Intangible Accum Depn - Software - OB'),  
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Intangible Accum Depn - Software - CB'),    
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'Intangible assets - Software - Additions'),
    DB('BSStgStaging',!BusinessUnit, !Currency, !FiscalMonth, 'Outlook', 'Calculated', 'Intangible Assets - Software - Additions');
  

