['GLAccount':'GLAccount':'Right-of-use asset - BS'] => 
DB('BSLease',!BusinessUnit, !Currency, 'BSComponent':'Total', !FiscalMonth, 'BSLeaseLocation':'Total', 'Outlook', 'RoU Closing balance');

['GLAccount':'GLAccount':'Lease liabilities (current) - BS'] => 
