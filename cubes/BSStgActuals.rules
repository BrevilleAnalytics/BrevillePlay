['GLAccount':'GLAccount':'Right-of-use asset - BS','BSComponent':'Reported Value', 'Balance'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth, 'Working Budget', 'Calculated', 'RoU Closing balance');
