  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth,  'Working Budget','Calculated', 'Plus NPD captialised added back')  ;

['GLAccount':'GLAccount':'300703','BSComponent':'Reported Value', 'Movement'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth,  'Outlook','Calculated', 'Dividends paid');
['GLAccount':'GLAccount':'300703','BSComponent':'Reported Value', 'Movement'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth,  'Working Budget','Calculated', 'Dividends paid');
['GLAccount':'GLAccount':'300704','BSComponent':'Reported Value', 'Movement'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth,  'Outlook','Calculated', 'Dividends paid (inter-company)');
['GLAccount':'GLAccount':'300704','BSComponent':'Reported Value', 'Movement'] => DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth,  'Working Budget','Calculated', 'Dividends paid (inter-company)');

[GLAccount:'GLAccount':'Intercompany Accounts - BS','BSComponent':'Reported Value', 'Balance'] => 
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth,  'Outlook','Calculated', 'Opening Balance - VLF'),
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth,  'Working Budget','Calculated', 'Opening Balance - VLF'),
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth,  'Outlook','Calculated', 'Closing Balance - VLF'),
  DB('BSStgStaging' ,!BusinessUnit, !Currency, !FiscalMonth,  'Working Budget','Calculated', 'Closing Balance - VLF');
  
#EndRegion

#Region BS Reporting

['Balance', 'Calculated', 'FiscalMonth':'FiscalMonth':'All FY', 'GLAccount':'GLAccount':'All BalanceSheet GLAccounts', 'Local', 'BusinessUnit':'BusinessUnit':'All Business Unit']=>
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Calculated', 'Balance' ),
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Calculated', 'Movement' ),
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Calculated', 'Balance' ),
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Calculated', 'Movement' )
  ;

['Movement', 'Calculated', 'FiscalMonth':'FiscalMonth':'All FY', 'GLAccount':'GLAccount':'All BalanceSheet GLAccounts', 'Local', 'BusinessUnit':'BusinessUnit':'All Business Unit']=> 
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Calculated', 'Balance' ),
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Calculated', 'Movement' ),
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Calculated', 'Balance' ),
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, 'Calculated', 'Movement' )
  ;  

['Balance', 'Calculated', 'FiscalMonth':'FiscalMonth':'All FY', 'GLAccount':'GLAccount':'Gross Sales', 'Local', 'BusinessUnit':'BusinessUnit':'All Business Unit']=>
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, 'Current Period – Intercompany', 'Calculated', 'Balance' ),
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, 'Current Period – Intercompany', 'Calculated', 'Movement' ),
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, 'Current Period – Intercompany', 'Calculated', 'Balance' ),
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, 'Current Period – Intercompany', 'Calculated', 'Movement' )
  ;

['Balance', 'Calculated'] =>
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Balance'),
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement'),
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Balance'),
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement')
  ; 

['Movement', 'Calculated'] =>
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Balance'),
  DB('BS Reporting','Outlook', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement'),
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Balance'),
  DB('BS Reporting','Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !GLAccount, !BSComponent, 'Movement')
  ;  

#EndRegion

#Region CF Reporting
['Balance', 'Calculated','GLAccount':'GLAccount':'Cash and cash equivalents - BS']=>
  DB('CF Reporting', 'Outlook', !FiscalMonth, !Currency, !BusinessUnit, !BSComponent, 'Opening Balance - Cash at Bank' ),
  DB('CF Reporting', 'Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !BSComponent, 'Opening Balance - Cash at Bank' ),
  DB('CF Reporting', 'Outlook', !FiscalMonth, !Currency, !BusinessUnit, !BSComponent, 'Total Closing Cash' ),
  DB('CF Reporting', 'Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !BSComponent, 'Total Closing Cash' );

['Balance', 'Calculated','GLAccount':'GLAccount':'Borrowings (current) - BS']=>
  DB('CF Reporting', 'Outlook', !FiscalMonth, !Currency, !BusinessUnit, !BSComponent, 'Closing Balance' ),
  DB('CF Reporting', 'Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !BSComponent, 'Closing Balance' );

['Balance', 'Calculated','GLAccount':'GLAccount':'Borrowings (non-current) - BS']=>
  DB('CF Reporting', 'Outlook', !FiscalMonth, !Currency, !BusinessUnit, !BSComponent, 'Closing Balance' ),
  DB('CF Reporting', 'Working Budget', !FiscalMonth, !Currency, !BusinessUnit, !BSComponent, 'Closing Balance' );
#EndRegion

#Region BS Lease

['Balance', 'GLAccount':'GLAccount':'Right-of-use asset - BS', 'Calculated']=>
  DB('BSLease', !BusinessUnit, !Currency, !BSComponent, 'Total', !FiscalMonth, 'Outlook', 'RoU Closing balance' ),
  DB('BSLease', !BusinessUnit, !Currency, !BSComponent, 'Total', !FiscalMonth, 'Working Budget', 'RoU Closing balance' );  

['Balance', 'GLAccount':'GLAccount':'Lease liabilities (current) - BS', 'Calculated']=>
  DB('BSLease', !BusinessUnit, !Currency, !BSComponent, 'Total', !FiscalMonth, 'Outlook', 'Lease Liability - Current Closing balance' ),
  DB('BSLease', !BusinessUnit, !Currency, !BSComponent, 'Total', !FiscalMonth, 'Working Budget', 'Lease Liability - Current Closing balance' );  

#EndRegion

#Region BS Interco Transfer

['Balance', 'GLAccount':'GLAccount':'Intercompany - BS', 'Reported Value']=>
  DB('BS Interco Transfer', 'Working Budget', !FiscalMonth, 'Transfer Currency', !BusinessUnit, !BusinessUnit, 'Opening Balance' ),
  DB('BS Interco Transfer', 'Outlook', !FiscalMonth, 'Transfer Currency', !BusinessUnit, !BusinessUnit, 'Opening Balance' );

#EndRegion

#Region Currency Conversion Feeder

['Local Currency'] => ['AUD-Constant'],['AUD-Budget'],['AUD-MonthEnd'],['AUD-Outlook'];

#EndRegion

