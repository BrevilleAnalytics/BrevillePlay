#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****

#----------------------------------------------------------------------------------------------------------------------------
#Region # Process Summary
#----------------------------------------------------------------------------------------------------------------------------

#<Process Description>
# This process updates the Customer Dimension - cretae main hierarchy and StatsGroup Hierarchy

#<Changes Log>
# V1 - 03/08/2022 - Jithu Varghese - CPM Group
#
#<Maintenance Log\>

#<Execute Method>
# Daily Schedule
#<Execute Method\>

#<Processes Executed>
# syProcessLogInitialise
# syProcessLogMessage
# syTITracker
#<Processes Executed\>

#<Execute Schedule>
# Scheduled daily
#<Execute Schedule\>

#<Estimated Run Time>
# ~3 secs
#<Estimated Run Time\>

#EndRegion # Process Summary

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Debugging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

 ENDIF ;
 
  sServer = 'Breville' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;



#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General


sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;



# constant
sDimName_Tgt = 'Customer';
sHierName_Tgt = 'Customer';
sHierName_Stats = 'StatsGroup';



sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#ODBC SQL Statement to update Customer dimension from Azure DataLake [ To Switch from CSV once Data lake is ready ]
#----------------------------------------------------------------------------------------------------------------------------
 DataSourceType = 'ODBC';


# SQL query

 sSQL = 'SET NOCOUNT ON ; 
Select 
Trim(CustomerNo) as Customer ,
CustomerName , 
StatsGroup , 
BusinessUnit 
from DimCustomerRegion' ;
						

DNS_Server = CellGetS( 'syEnvironment', 'Breville', 'ODBC DSN for DL'  );


# Data Source

 DataSourceType = 'ODBC' ;
 DatasourceNameForServer = DNS_Server ;
 DatasourceQuery = sSQL;


#~~~~~~~~~ Build dimension ~~~~~~~~~~~~~~~~
# Create Customer dim

If( DimensionExists( sDimName_Tgt ) = 0 );
  DimensionCreate( sDimName_Tgt );
EndIf;


# Create Customer Hierarchy

If( HierarchyExists( sDimName_Tgt, sHierName_Tgt ) = 0 );
  HierarchyCreate( sDimName_Tgt, sHierName_Tgt );
Else;
  HierarchyDeleteAllElements(sDimName_Tgt, sHierName_Tgt);
EndIf;

# Create StatsGroup Hierarchy

If( HierarchyExists( sDimName_Tgt, sHierName_Stats ) = 0 );
  HierarchyCreate( sDimName_Tgt, sHierName_Stats );
Else;
  HierarchyDeleteAllElements(sDimName_Tgt, sHierName_Stats );
  
# One off delete as customer is now BU+CustomerCode for uniqueness as per Daniel's suggestion
# HierarchyDeleteAllElements(sDimName_Tgt, 'Leaves' );
EndIf;

# Create Top Element for Main Hierarchy
sTopElement = 'All Customer' ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sTopElement, 'C' ) ;

# Create Top Element for StatsGroup Hierarchy
sTopElementSG = 'All Stats Group' ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Stats , '' , sTopElementSG, 'C' ) ;

# ~~~~~~~~~~ Create attribtues ~~~~~~~~~~~~~~~~~~~~
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'Caption', 'S');
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'CodeCaption', 'A');
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'StatsGroup', 'S');


#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

# Main Hierarchy Build - All Customer

sTopElement = 'All Customer' ;
sTopElementSG = 'All Stats Group' ;
sElName = vBU | vCustomer ;
sElNameCus = vCustomer ;
      if ( sElNameCus @<> 'Other' ) ;
         HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sElName , 'N' ) ;
      endif;
      HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sTopElement , sElName , 1 ) ;
      
# StatsGroup Hierachy Build

sElParentName = vStatsGroup ;
      HierarchyElementInsert ( sDimName_Tgt , sHierName_Stats , '' , sElName , 'N' ) ;
      if ( sElParentName @<> ''  &  sElParentName @<> sElName  & sElParentName @<> 'OTHER' ) ;
        HierarchyElementInsert ( sDimName_Tgt , sHierName_Stats , '' , sElParentName , 'C' ) ;
        HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Stats , sElParentName , sElName , 1 ) ;
        HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Stats , sTopElementSG , sElParentName , 1 ) ;
      elseif ( sElParentName @= '' &  sElParentName @<> sElName & sElParentName @<> 'OTHER' ) ;
        HierarchyElementInsert ( sDimName_Tgt , sHierName_Stats , '' , 'No Stats Group' , 'C' ) ;
        HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Stats , 'No Stats Group' , sElName , 1 ) ;
        HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Stats , sTopElementSG , 'No Stats Group' , 1 ) ;
      endif ;
     
     if ( sElParentName @= 'OTHER' ) ;
        HierarchyElementInsert ( sDimName_Tgt , sHierName_Stats , '' , 'Stats Group' |' - ' | sElParentName , 'C' ) ;
        HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Stats , 'Stats Group' |' - ' | sElParentName , sElName , 1 ) ;
        HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Stats , sTopElementSG , 'Stats Group' |' - ' | sElParentName , 1 ) ;
     endif ;
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

# Add Attributes
sElName = vBU | vCustomer ;
    ElementAttrPutS ( sElName | ' - ' | vCustomerName , sDimName_Tgt , sHierName_Tgt , sElName , 'CodeCaption' ) ;
    ElementAttrPutS ( vCustomerName , sDimName_Tgt , sHierName_Tgt , sElName , 'Caption' ) ;
    ElementAttrPutS ( vStatsGroup , sDimName_Tgt , sHierName_Tgt , sElName , 'StatsGroup' ) ;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully.'   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#End Region # TI Tracker
#endregion