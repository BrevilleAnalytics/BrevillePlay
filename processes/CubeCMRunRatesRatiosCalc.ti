#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Debugging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';
  sTestFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | 'RunRatesData.txt';

pVersion = DimensionElementPrincipalName( 'Version', pVersion ) ;

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Turn off Cube Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
sLogValue = CellGetS ( '}CubeProperties' , 'CMRunRates' , 'LOGGING' ) ;
CellPutS ( 'NO' ,  '}CubeProperties' , 'CMRunRates' , 'LOGGING' ) ;



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

 ENDIF ;
 
  sServer = 'Breville' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;



#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General


sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;


sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#End Region # Process control



# Process Variables

# General
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  csProcess |'.'| sTimestamp | '.' | sRandomInt;

sCub_Tgt = 'CMRunRates' ;
sCub_Src = sCub_Tgt ;

sSub_Src = '}System.Src.' | sUniqueName ;
sView_Src = '}System.Src.' | sUniqueName ;

sSub_Tgt = '}System.Tgt.' | sUniqueName ;
sView_Tgt = '}System.Tgt.' | sUniqueName ;


# Constants
ptemp = 0 ; 



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~# Create temp subsets and assign it to the view~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------


sStringMonth = 'Month' ;
sRatioDriver = NumberToString ( pnPeriods ) | sStringMonth ;



# Create temp cubeview and Zero Out

IF( ViewExists( sCub_Tgt , sView_Tgt ) = 1 ) ; 
 ViewDestroy ( sCub_Tgt, sView_Tgt ) ;
ENDIF;
ViewCreate( sCub_Tgt, sView_Tgt , ptemp ) ;

i_TabDim = 1 ;
While ( TabDim ( sCub_Tgt , i_TabDim ) @<> '' ) ;
   sDim = TabDim ( sCub_Tgt , i_TabDim ) ;

   If( sDim @= 'Product' ) ;
      #sMDX = '{[' | sDim | '].[' | sDim | '].[AQP-RKE2] } ' ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'Segment' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'BusinessUnit' ) ;
         if( pBU @= '' ) ;
            sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
            else ;
            sMDX = '{ [' | sDim | '].[' | sDim | '].[' | pBU | '] }' ;
         endif;
   ElseIf( sDim @= 'Theatre' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'Version' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[' | pVersion | '] }' ;
   ElseIf( sDim @= 'FiscalMonth' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[No FiscalMonth] }' ;
   ElseIf( sDim @= 'Currency' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[Local Currency] }' ;
   ElseIf( sDim @= 'CMRatios' ) ;
      sMDX =
             '{[' | sDim | '].[' | sDim | '].[Baseline Return %] ,
               [' | sDim | '].[' | sDim | '].[Average Selling Price] ,
               [' | sDim | '].[' | sDim | '].[COGS Unit Cost] ,
               [' | sDim | '].[' | sDim | '].[Rebate %] ,
               [' | sDim | '].[' | sDim | '].[Warranty Unit Cost] ,
               [' | sDim | '].[' | sDim | '].[Freight Unit Cost] }' ;
   ElseIf( sDim @= 'CMRunRatesMeasure' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[' | sRatioDriver | '] }' ;
   Else ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   EndIf ;

   SubsetCreateByMDX ( sSub_Tgt , sMDX , ptemp ) ;
   SubsetMDXSet (sDim , sSub_Tgt , '' ) ;
   ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

i_TabDim = i_TabDim + 1 ;
End ;

ViewZeroOut	 ( sCub_Tgt , sView_Tgt ) ;



# Create temp cubeview for Source

IF( ViewExists( sCub_Src , sView_Src ) = 1 ) ; 
 ViewDestroy ( sCub_Src , sView_Src ) ;
ENDIF;

ViewCreate( sCub_Src , sView_Src , ptemp ) ;


i_TabDim = 1 ;
While ( TabDim ( sCub_Src  , i_TabDim ) @<> '' ) ;
   sDim = TabDim ( sCub_Src  , i_TabDim ) ;

   If( sDim @= 'Product' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'Segment' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'BusinessUnit' ) ;
         if( pBU @= '' ) ;
            sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
            else ;
            sMDX = '{ [' | sDim | '].[' | sDim | '].[' | pBU | '] }' ;
         endif;

   ElseIf( sDim @= 'Theatre' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'Version' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[' | pVersion | '] }' ;
   ElseIf( sDim @= 'FiscalMonth' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[No FiscalMonth] }' ;
   ElseIf( sDim @= 'CMRatios' ) ;
      sMDX = '{[' | sDim | '].[' | sDim | '].[Gross Sales]  ,
#} ';
               [' | sDim | '].[' | sDim | '].[Shipped Units] ,
               [' | sDim | '].[' | sDim | '].[Returned Units] ,
               [' | sDim | '].[' | sDim | '].[Rebates] ,
               [' | sDim | '].[' | sDim | '].[Cost of Goods Sold] ,
               [' | sDim | '].[' | sDim | '].[Warranty] ,
               [' | sDim | '].[' | sDim | '].[Freight]
 			   }' ;
   ElseIf( sDim @= 'Currency' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[Local Currency] }' ;
   ElseIf( sDim @= 'CMRunRatesMeasure' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[' | sRatioDriver | '] }' ;
   Else ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   EndIf ;

   SubsetCreateByMDX ( sSub_Src , sMDX , ptemp ) ;
   SubsetMDXSet (sDim , sSub_Src , '' ) ;
   ViewSubsetAssign ( sCub_Src  , sView_Src , sDim , sSub_Src ) ;

i_TabDim = i_TabDim + 1 ;
End ;


ViewExtractSkipCalcsSet ( sCub_Src  , sView_Src , 1 ) ;
ViewExtractSkipRuleValuesSet (  sCub_Src  , sView_Src , 1 ) ;
ViewExtractSkipZeroesSet (  sCub_Src  , sView_Src , 1 ) ;


DataSourceType = 'VIEW' ;
DataSourceCubeview = sView_Src ;
#DataSourceNameForServer =  sView_Src  ;
DataSourceNameForClient = sView_Src ;

#ProcessBreak;
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****


##Counter
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
nRecordCountData = nRecordCountData  + 1 ;


## Process Function
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
sStringMonth = 'Month' ;
sRatioDriver = NumberToString ( pnPeriods ) | sStringMonth ;


# Get Values for calculating Ratios
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
sGrossSales 	= CellGetN( 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Gross Sales' , 'Local Currency' , sRatioDriver );
sNetShipments 	= CellGetN( 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Net Shipments' , 'Local Currency' , sRatioDriver );
sReturnedUnits 	= CellGetN( 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Returned Units' , 'Local Currency' , sRatioDriver );
sShippedUnits 	= CellGetN( 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Shipped Units' , 'Local Currency' , sRatioDriver  ); 
sRebates 	= CellGetN( 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Rebates' , 'Local Currency' , sRatioDriver  );
sCOGS 		= CellGetN( 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Cost of Goods Sold' , 'Local Currency' , sRatioDriver  );
sWarranty 	= CellGetN( 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Warranty' , 'Local Currency' , sRatioDriver  );
sFreight 		= CellGetN( 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Freight' , 'Local Currency' , sRatioDriver  );
sSKUPromoCosts = CellGetN( 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'SKU Promo Costs' , 'Local Currency' , sRatioDriver  );

# Calculate Ratios
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  sReturnPct =  ABS ( sReturnedUnits  \ sShippedUnits )   ; 
  sASP = ABS ( sGrossSales \ sNetShipments ) ;
  sRebatePct = ABS ( sRebates \ sGrossSales ) ;
  sCOGSUnitCost = ABS ( sCOGS \ sShippedUnits ) ;
  sWarrantyUnitCost = ABS ( sWarranty \ sShippedUnits ) ;
  sFreightUnitCost = ABS ( sFreight \ sShippedUnits ) ;
  sPromoUnitCost =  ABS ( sSKUPromoCosts \ sNetShipments ) ;


## Update Values
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~


   CellPutN( sReturnPct , 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Baseline Return %' , 'Local Currency' , sRatioDriver  ) ;
   CellPutN( sASP ,	 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Average Selling PRice' , 'Local Currency' , sRatioDriver  ) ;
   CellPutN( sRebatePct, 	'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Rebate %' , 'Local Currency' , sRatioDriver  ) ;
   CellPutN( sCOGSUnitCost , 	'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'COGS Unit Cost' , 'Local Currency' , sRatioDriver  ) ;
   CellPutN( sWarrantyUnitCost , 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Warranty Unit Cost' , 'Local Currency' , sRatioDriver  ) ;
   CellPutN( sFreightUnitCost , 	'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Freight Unit Cost' , 'Local Currency' , sRatioDriver  ) ;
   CellPutN( sPromoUnitCost , 	'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'SKU Promo Cost Input' , 'Local Currency' , sRatioDriver  ) ;

# put a 1 to the flag

   CellPutN( 1 , 'CMRunRates', vProduct, vSegment, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'No Ratio' , 'Local Currency' , 'Flag'  ) ;

   
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Turn off Cube Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
sLogValue = CellGetS ( '}CubeProperties' , 'CMRunRates' , 'LOGGING' ) ;
CellPutS ( sLogValue,  '}CubeProperties' , 'CMRunRates' , 'LOGGING' ) ;
            
#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully. Total records: ' | NumberToString (nRecordCountMetadata  )   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

if ( pBU @= '' ) ;
sBU = 'All BUs';
else ;
sBU = pBU ;
endif ;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pParameter01' , 'Ratio Driver: ' | sRatioDriver ,
   'pParameter02' , 'Version: ' | pVersion ,
   'pParameter03' , 'BU: ' | sBU ,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#End Region # TI Tracker
#endregion