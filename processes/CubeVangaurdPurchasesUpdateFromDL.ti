# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General

sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;

sSub_Tgt= '}System.Tgt.' | sUniqueName ;



sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#End Region # Process control

# Process Variables

# General
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  csProcess |'.'| sTimestamp | '.' | sRandomInt;
sSub_Src = '}System.Src.' | sUniqueName ;
sView_Src = '}System.Src.' | sUniqueName ;
sSub_Tgt = '}System.Tgt.' | sUniqueName ;
sView_Tgt = 'TmpBSStgActuals' ;
sLogMessage ='';

# Constants
sSub_Tgt= '}System.Tgt.' | sUniqueName ;
sCub_Tgt = 'VanguardPurchases' ;

#ODBC SQL Statement to update historical CM sales data by month cube CMStgActuals from Azure DataLake
#----------------------------------------------------------------------------------------------------------------------------

DataSourceType = 'ODBC';


# SQL query

 sSQL = 'SET NOCOUNT ON; 
SELECT [Product_2]
      ,[BusinessUnit]
      ,[Month_1]
      ,[Quantity]
      ,[CalendarMonth]
      ,[file_datetime]
  FROM [stg].[VanguardFinanceForecast]
where Quantity > 0
';
#where[monthYear] = ''' |sCurrentMonth| ''' and [businessUnit] = ''' |pBU| '''

 
		
DNS_Server = 'brev-dev-syn-fpa';
#CellGetS( 'syEnvironment', 'Breville', 'ODBC DSN for DL SQL'  );


# Data Source

 DataSourceType = 'ODBC' ;
 DatasourceNameForServer = DNS_Server ;
 DatasourceQuery = sSQL;

# Create temp cubeview
IF( ViewExists( sCub_Tgt , sView_Tgt ) = 1 ) ; 
 ViewDestroy ( sCub_Tgt, sView_Tgt ) ;
ENDIF;
ViewCreate( sCub_Tgt, sView_Tgt , 1 ) ;

# Create temp subsets and assign it to the view

i_TabDim = 1 ;
While ( TabDim ( sCub_Tgt , i_TabDim ) @<> '' ) ;
   sDim = TabDim ( sCub_Tgt , i_TabDim ) ;
   sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   SubsetCreateByMDX ( sSub_Tgt , sMDX , 1 ) ;
   SubsetMDXSet (sDim , sSub_Tgt , '' ) ;
   ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

i_TabDim = i_TabDim + 1 ;
End ;

#------ View zero out
#ViewZeroOut(sCub_Tgt, sView_Tgt);

 vNow = Date(Now(),1);
# vNow = '2023-10-12';
DimensionElementInsertDirect ('Checkpoint', '', vNow,'N');
#endregion
#region Data

# sMonth = SUBST( vMonth , 1 , 3 );
# sYear = SUBST ( vMonth, LONG (vMonth) -4 +1 , 4);
# sPeriod = 'F' | sYear | '-' | sMonth ;

sPeriod = ATTRS( 'CalendarMonth', vCalendarMonth , 'FiscalMonth' );
#sPeriod = ATTRS( 'CalendarMonth', 'October 2023' , 'FiscalMonth' );

#~~~~~~~~~ set validation ~~~~~~~~~~
#~~~ check if element exists
# Customer
sDim = 'Product' ;
sEl = vProduct ;
If (DIMIX( sDim, sEl  ) = 0  ) ;
  sMessage = 'Product = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

# BU
sDim = 'BusinessUnit' ;
sEl = vBusinessUnit ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'BusinessUnit = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

sDim = 'FiscalMonth' ;
sEl = sPeriod ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'FiscalMonth = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         #ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

CostOfGoodsSold_WorkingBudget = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Budget' ,
               sPeriod ,'Local' , 'Calculated','Cost of Goods Sold') ;
Shipped_WorkingBudget = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Budget' ,
               sPeriod ,'Local' , 'Calculated','ShippedUnits') ;
COGS_WorkingBudget = CostOfGoodsSold_WorkingBudget /  Shipped_WorkingBudget;

               
CostOfGoodsSold_WorkingOutlook = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Outlook' ,
               sPeriod ,'Local' , 'Calculated','Cost of Goods Sold') ;
Shipped_WorkingOutlook = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Outlook' ,
               sPeriod ,'Local' , 'Calculated','Shipped Units') ;
COGS_WorkingOutlook = CostOfGoodsSold_WorkingOutlook /  Shipped_WorkingOutlook;


ASCIIOutput( sTestFile, numbertostring(vQuantity) , vProduct , vBusinessUnit  , sPeriod);



CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Working Budget',vNow,'Units');
CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Working Outlook',vNow,'Units');

CellIncrementN( COGS_WorkingBudget , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Working Budget',vNow,'COGS');
CellIncrementN( COGS_WorkingOutlook , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Working Outlook',vNow,'COGS');

CellIncrementN( COGS_WorkingBudget *vQuantity, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit ,'Local','Working Budget',vNow,'PurchaseAmount');
CellIncrementN( COGS_WorkingOutlook *vQuantity, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit ,'Local','Working Outlook',vNow,'PurchaseAmount');


