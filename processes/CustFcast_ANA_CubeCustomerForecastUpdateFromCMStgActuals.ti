#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****


#Put data from the view assigned to the process into the Customer Forecast cube using attributes for StatsGroup (to match CustomerCustFcast Dimension)
If (AttrS('Customer',Customer,'StatsGroup') @= '');
vSG = 'No Stats Group';
Else;
vSG = AttrS('Customer',Customer,'StatsGroup');
endIf;

#Get Month and Version

If (AttrS('FiscalMonth',FiscalMonth,'Year') @= '2023');
vVersion = 'Actual';
elseif (AttrS('FiscalMonth',FiscalMonth,'Year') @= '2022');
vVersion = 'Prior Year';
elseif (AttrS('FiscalMonth',FiscalMonth,'Year') @= '2021');
vVersion = '2 Years Prior';
endIf;


#~~~~~~~~~ set validation ~~~~~~~~~~
#~~~ check if element exists
# Customer
sDim = 'CustomerCustFcast' ;
sEl = vSG ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'Customer = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

# Product
sDim = 'ProductCustFcast' ;
sEl = Product ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'Product = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

# BU
sDim = 'BusinessUnit' ;
sEl = BusinessUnit ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'BusinessUnit = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

sDim = 'FiscalMonth' ;
sEl = FiscalMonth ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'FiscalMonth = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;
# ASCIIOutput( sTestFile, Product, Customer, BusinessUnit, Theatre, Version, FiscalMonth, 'Local', CMStgActualsMeasure);



#CellIncrementN(Value, vCub_Tgt, Product, vSG, BusinessUnit, Theatre, Version, FiscalMonth, 'Local', CMStgActualsMeasure);

#Put data from the view assigned to the process into the Customer Forecast cube at Prior Year on VersionCustFcast Dimension using fiscal month attribute NYPeriod)
CellIncrementN(Value, vCub_Tgt, Product, vSG, BusinessUnit, Theatre, vVersion, AttrS('FiscalMonth',FiscalMonth,'Short_Text'), 'Local', CMStgActualsMeasure);

nRecordCountData = nRecordCountData +1;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

            
#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully. Total records: ' | NumberToString ( nRecordCountData )   ;
EndIf;

logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#End Region # TI Tracker
#endregion