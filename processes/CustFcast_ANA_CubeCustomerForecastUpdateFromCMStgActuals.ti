#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 #IF ( psTITracker @= '' ) ;
  #psTITracker =  CellGetS ( 'syEnvironment', 'BrevillePlay', 'psyProcessLog' ) ;

 #ENDIF ;
 
  sServer = 'Breville' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;



#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General


sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;

sSub_Tgt= '}System.Tgt.' | sUniqueName ;



sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#End Region # Process control


# Process Variables

# General
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  csProcess |'.'| sTimestamp | '.' | sRandomInt;
sSub_Src = '}System.Src.' | sUniqueName ;
sView_Src = '}System.Src.' | sUniqueName ;
sSub_Tgt = '}System.Tgt.' | sUniqueName ;
sView_Tgt = '}System.Tgt.' | sUniqueName ;
sLogMessage ='';

# Constants
sSub_Tgt= '}System.Tgt.' | sUniqueName ;
sCub_Tgt = 'CMStgActuals' ;

#-- Set the period range to update 
#-- the period range 
sFiscalMonth = DimensionElementPrincipalName( 'FiscalMonth', CellGetS( 'BRAsVersion', 'Actual', 'Actual Month'));
# nPeriodIndex_End = StringToNumber(ATTRS('FiscalMonth', sFiscalMonth, 'PeriodIndex'));
# nPeriodIndex_Start = nPeriodIndex_End - pnPeriodsUpdate;
# sFiscalMonth_Start = DimensionElementPrincipalName( 'FiscalMonth', FILL( '0', 10 - LONG(NumberToString(nPeriodIndex_Start))) | NumberToString(nPeriodIndex_Start));

sCurrentMonth = ATTRS( 'FiscalMonth', sFiscalMonth , 'CalendarMonth' ) ;




# Create temp cubeview for clearing prior data
#Variables
vCub_Tgt = 'CustomerForecast' ;
vView_Tgt = 'CustClearData' ;
vSub_Tgt = 'CustClearData' ;
pTemp = 1 ; 

IF( ViewExists( vCub_Tgt , vView_Tgt ) = 1 ) ; 
 ViewDestroy ( vCub_Tgt, vView_Tgt ) ;
ENDIF;
ViewCreate( vCub_Tgt, vView_Tgt , pTemp ) ;

i_TabDim = 1 ;
While ( TabDim ( vCub_Tgt , i_TabDim ) @<> '' ) ;
   sDim = TabDim ( vCub_Tgt , i_TabDim ) ;

  If( sDim @= 'ProductCustFcast' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  ElseIf( sDim @= 'CustomerCustFcast' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;    
  ElseIf( sDim @= 'BusinessUnit' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  ElseIf( sDim @= 'Theatre' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  ElseIf( sDim @= 'VersionCustFcast' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[Actual],
                [' | sDim | '].[' | sDim | '].[Prior Year],
                [' | sDim | '].[' | sDim | '].[2 Years Prior]}' ;
  ElseIf( sDim @= 'MonthCustFcast' ) ;
      #sMDX = '{TM1FILTERBYLEVEL( {DISTINCT({DESCENDANTS([' | sDim | '].[' | sDim | '].[Financial Year])})}, 0)}' ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }'  ;
  ElseIf( sDim @= 'Currency' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[Local Currency] }' ; 
  ElseIf( sDim @= 'MeasureCustFcast' ) ;
       sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }'  ;
  Else ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  EndIf ;

   SubsetCreateByMDX ( vSub_Tgt , sMDX ,sDim, pTemp ) ;
   SubsetMDXSet (sDim , vSub_Tgt , '' ) ;
   ViewSubsetAssign (vCub_Tgt , vView_Tgt , sDim , vSub_Tgt ) ;

i_TabDim = i_TabDim + 1 ;
End ;

#------ View zero out old data before reloading
ViewZeroOut(vCub_Tgt, vView_Tgt);


#Create View as source for process:
#Variables
sCube = 'CMStgActuals' ;
sSub = 'DG_CMStgActOutlook' ;
sView = sSub ;
sEle = '' ;
pTemp = 0 ; 

If ( ViewExists ( sCube , sView ) <> 0 ) ;
   ViewDestroy ( sCube , sView ) ;
EndIf ;
ViewCreate ( sCube , sView , pTemp ) ;

sDim = 'Customer' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

# ViewExtractSkipCalcsSet ( sCube , sView , 0 ) ;
# ViewExtractSkipRuleValuesSet ( sCube , sView , 1 ) ;
# ViewExtractSkipZeroesSet ( sCube , sView , 1 ) ;

sDim = 'Product' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'Segment' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'BusinessUnit' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp  ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'Version' ;
sEle = 'Actual' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDeleteAllElements ( sDim , sSub ) ;
Else ;
   SubsetCreate ( sDim , sSub ) ;
EndIf ;
SubsetElementInsert ( sDim , sSub , sEle , 1 ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'FiscalMonth' ;
#sMDX = '{ [' | sDim | '].[' | sDim | '].[2023001] }';
#sMDX = '{DISTINCT({[FiscalMonth].[FiscalMonth].[2022],DESCENDANTS([FiscalMonth].[FiscalMonth].[2022] , 99 , LEAVES)}),
#DISTINCT({[FiscalMonth].[FiscalMonth].[2023],DESCENDANTS([FiscalMonth].[FiscalMonth].[2023] , 99 , LEAVES)})}';
sMDX = '{DISTINCT(DESCENDANTS([FiscalMonth].[FiscalMonth].[2021] , 99 , LEAVES)),DISTINCT(DESCENDANTS([FiscalMonth].[FiscalMonth].[2022] , 99 , LEAVES)),DISTINCT(DESCENDANTS([FiscalMonth].[FiscalMonth].[2023] , 99 , LEAVES))}';
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'Theatre' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'CMStgActualsMeasure';
       sMDX = '{ [' | sDim | '].[' | sDim | '].[Contribution Margin],
                [' | sDim | '].[' | sDim | '].[Shipped Units],
                [' | sDim | '].[' | sDim | '].[Returned Units],
                [' | sDim | '].[' | sDim | '].[Net Sales] },
                [' | sDim | '].[' | sDim | '].[Gross Sales] }';               
               
# sMDX = '{[CMStgActualsMeasure].[CMStgActualsMeasure].[Contribution Margin]}';
                                
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

ViewExtractSkipCalcsSet ( sCube , sView , 0 ) ;  
# 0 = take data at consolidation
ViewExtractSkipRuleValuesSet ( sCube , sView , 1 ) ;
#0 = take rule result as data (if )
ViewExtractSkipZeroesSet ( sCube , sView , 1 ) ;


# Assign Datasource
DataSourceType = 'VIEW' ;
DataSourceNameForServer = sCube ;
DataSourceCubeview = sView ;



#Create View as source for process:
