#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****

#<Process Description>
# This process updates the Business Unit Dimension using CM Actuals and GL OPEX Actuals Data
# Clones the business unit dimension into From Business Unit and To Business Unit

#<Changes Log>
# V1 - 16/09/2022 - Jithu Varghese - CPM Group
# V2 - 08/04/2024 - J Ragozzino CPM

#<Maintenance Log\>

#<Execute Method>
# Daily Schedule
#<Execute Method\>

#<Processes Executed>
# syProcessLogInitialise
# syProcessLogMessage
# syTITracker
#<Processes Executed\>

#<Execute Schedule>
# Scheduled daily
#<Execute Schedule\>

#<Estimated Run Time>
# ~3 secs
#<Estimated Run Time\>

#EndRegion # Process Summary

#Region ~~~~~~~~~~Debugging
#----------------------------------------------------------------------------------------------------------------------------
# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';
#EndRegion

#Region ~~~~~~~~~~System Variables (Update Server Name)
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;
 ENDIF ;
 
  sServer = 'Breville Play' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;
#EndRegion

#Region ~~~~~~~~~~Logging
## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;
#EndRegion

#Region ~~~~~~~~~~Process Constants and Variables
# Region: General

sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;

# constant
sDimName_Tgt = 'BusinessUnit';
sDimClone1 = 'From Business Unit';
sDimClone2 = 'To Business Unit';

# Create Business Unit dims
IF( DimensionExists( sDimName_Tgt ) = 0 );
  DimensionCreate( sDimName_Tgt );
ENDIF;

IF( DimensionExists( sDimClone1 ) = 0 );
  DimensionCreate( sDimClone1 );
ENDIF ;

IF( DimensionExists( sDimClone2 ) = 0 );
  DimensionCreate( sDimClone2 );    
ENDIF;

# Create Business Unit Hierarchy

# If( HierarchyExists( sDimName_Tgt, sHierName_Tgt ) = 0 );
#   HierarchyCreate( sDimName_Tgt, sHierName_Tgt );
# Else;
#   HierarchyDeleteAllElements(sDimName_Tgt, sHierName_Tgt);
# EndIf;

sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );

#EndRegion

#Region ODBC SQL Statement to update GLAccount dimension from Azure DataLake [ To Switch from CSV once Data lake is ready ]

# SQL query

 sSQL = 'SET NOCOUNT ON; 
  SELECT distinct businessUnit
  FROM [dbo].[Actual_Expenses]
  UNION
  SELECT 
      distinct [BusinessUnit]
  FROM [dbo].[ActualCM]';
						


DNS_Server = CellGetS( 'syEnvironment', 'Breville', 'ODBC DSN for DL'  );


# Data Source

 DataSourceType = 'ODBC' ;
 DatasourceNameForServer = DNS_Server ;
 DatasourceQuery = sSQL;
#EndRegion

# Create Top Hierarchy
sTopElement = 'All Business Unit';

DimensionElementInsert ( sDimName_Tgt , '' , sTopElement, 'C' );
DimensionElementInsert ( sDimClone1,'',sTopElement, 'C');
DimensionElementInsert ( sDimClone2,'',sTopElement, 'C');

#Exception for BCN, BRG and LIT
DimensionElementInsert ( sDimName_Tgt , '' , 'BCN', 'N' );
DimensionElementInsert ( sDimName_Tgt , '' , 'LIT', 'N' );
DimensionElementInsert ( sDimName_Tgt , '' , 'BRG', 'N' );

DimensionElementComponentAdd (sDimName_Tgt, sTopElement, 'BCN', 1 );
DimensionElementComponentAdd (sDimName_Tgt, sTopElement, 'LIT', 1 );
DimensionElementComponentAdd (sDimName_Tgt, sTopElement, 'BRG', 1 );

DimensionElementInsert ( sDimClone1 , '' , 'BCN', 'N' );
DimensionElementInsert ( sDimClone1 , '' , 'LIT', 'N' );
DimensionElementInsert ( sDimClone1 , '' , 'BRG', 'N' );

DimensionElementComponentAdd (sDimClone1, sTopElement, 'BCN', 1 );
DimensionElementComponentAdd (sDimClone1, sTopElement, 'LIT', 1 );
DimensionElementComponentAdd (sDimClone1, sTopElement, 'BRG', 1 );

DimensionElementInsert ( sDimClone2 , '' , 'BCN', 'N' );
DimensionElementInsert ( sDimClone2 , '' , 'LIT', 'N' );
DimensionElementInsert ( sDimClone2 , '' , 'BRG', 'N' );

DimensionElementComponentAdd (sDimClone2, sTopElement, 'BCN', 1 );
DimensionElementComponentAdd (sDimClone2, sTopElement, 'LIT', 1 );
DimensionElementComponentAdd (sDimClone2, sTopElement, 'BRG', 1 );

# ~~~~~~~~~~ Create attribtues ~~~~~~~~~~~~~~~~~~~~
AttrInsert(sDimName_Tgt, '', 'Caption', 'S');
AttrInsert(sDimName_Tgt, '', 'CodeCaption', 'A');

AttrInsert(sDimClone1, '', 'Caption', 'S');
AttrInsert(sDimClone1, '', 'CodeCaption', 'A');

AttrInsert(sDimClone2, '', 'Caption', 'S');
AttrInsert(sDimClone2, '', 'CodeCaption', 'A');
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

sElName = vBU ;

IF ( vBU @<> '' ) ;
      DimensionElementInsert ( sDimName_Tgt , '' , sElName , 'N' ) ;
      DimensionElementComponentAdd ( sDimName_Tgt , sTopElement , sElName , 1 ) ;

      DimensionElementInsert ( sDimClone1 , '' , sElName , 'N' ) ;
      DimensionElementComponentAdd ( sDimClone1 , sTopElement , sElName , 1 ) ;

      DimensionElementInsert ( sDimClone2 , '' , sElName , 'N' ) ;
      DimensionElementComponentAdd ( sDimClone2 , sTopElement , sElName , 1 ) ;
    
ENDIF ;

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

#Region ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully. Total records: ' | NumberToString (nRecordCountMetadata  )   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference, 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#EndRegion
#endregion