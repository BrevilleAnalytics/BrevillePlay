#ODBC SQL Statement to update Product dimension from Azure DataLake [ Switched from CSV once Data lake was ready ]
#----------------------------------------------------------------------------------------------------------------------------
 DataSourceType = 'ODBC';


# SQL query

 sSQL = 'SET NOCOUNT ON ; 
select Distinct 
itemcode,
parentcode,
ProductName,
category,
Portfolio,
HierarchyBrand,
Segment,
BusinessUnit 
from DimProduct 
where itemcode <>'''' OR itemcode <> ''NULL''' ;

# Filter Removed as fix [No itemcode to have parents with same name ] has been put into the source data
# where itemcode <> Portfolio and itemcode <> category and itemcode <> HierarchyBrand and itemcode <> ''SPAREPARTS''
# Data Source

DNS_Server = CellGetS( 'syEnvironment', 'Breville', 'ODBC DSN for DL'  );


# Data Source

 DataSourceType = 'ODBC' ;
 DatasourceNameForServer = DNS_Server ;
 DatasourceQuery = sSQL;


