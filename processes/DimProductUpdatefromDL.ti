      if ( sElParentName1 @= '' & sElParentName2 @<> '' ) ;
          HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'No Portfolio' , 'C' ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'No Portfolio' , sElName , 1 ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sTopElement , 'No Portfolio' , 1 ) ;
      endif ;
      
      if ( sElParentName2 @= '' & sElParentName1 @= '' ) ;
          HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'No Category' , 'C' ) ;
          HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'No Portfolio' , 'C' ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'No Category' , sElName , 1 ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'No Portfolio' ,'No Category' , 1 ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sTopElement , 'No Portfolio' , 1 ) ;
      endif ;      
      
      if ( sElParentName2 @= sElParentName1 & sElParentName2 @<> '' & sElParentName1 @<> '' ) ;
          HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sElParentName2 | ' - ' | sElParentName1 , 'C' ) ;
          HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'Portfolio' | ' - ' | sElParentName1 , 'C' ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElParentName2 | ' - ' | sElParentName1 , sElName , 1 ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'Portfolio' | ' - ' | sElParentName1 , sElParentName2 | ' - ' | sElParentName1 , 1 ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sTopElement , 'Portfolio' | ' - ' | sElParentName1 , 1 ) ;
      endif ;

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

# Add Attributes
sElName = vItemCode ;
sElParentName2 = vCategory ;
sElParentName1 = vPortfolio ;

    ElementAttrPutS ( vProductName , sDimName_Tgt , sHierName_Tgt , sElName , 'Description' ) ; 
 if (sElName @<> sElParentName2 | ' - ' | sElParentName1 & sElName @<> 'Subscription Revenue' & sElName @<> 'Unallocated' ) ;
    ElementAttrPutS ( sElName | ' - ' | vProductName , sDimName_Tgt , sHierName_Tgt , sElName , 'CodeCaption' ) ;
 endif;

# ElementAttrPutS( vIs365 , sDimName_Tgt , sHierName_Tgt , sElName  , 'Is365' ) ;
ElementAttrPutS ( vParentCode , sDimName_Tgt , sHierName_Tgt , sElName  , 'ParentCode' ) ;
ElementAttrPutS( vBrand , sDimName_Tgt , sHierName_Tgt , sElName  , 'Brand' ) ;
ElementAttrPutS( vPortfolio , sDimName_Tgt , sHierName_Tgt , sElName  , 'Portfolio' ) ;
# ElementAttrPutS( vProductLaunchedInLastTwoYears , sDimName_Tgt , sHierName_Tgt , sElName  , 'LaunchedInLastTwoYears' ) ;
