#region Prolog
StringGlobalVariable('MonthName');
StringGlobalVariable('MonthNameLong');
MonthName = 'MonthNameError';
MontNameLong = 'MonthNameError';
if(MonthNo = 1);
  MonthName = 'Jan';
  MontNameLong = 'January';
elseif(MonthNo = 2);
  MonthName = 'Feb';
  MontNameLong = 'February';
elseif(MonthNo = 3);
  MonthName = 'Mar';
  MontNameLong = 'March';
elseif(MonthNo = 4);
  MonthName = 'Apr';
  MontNameLong = 'April';
elseif(MonthNo = 5);
  MonthName = 'May';
  MontNameLong = 'May';
elseif(MonthNo = 6);
  MonthName = 'Jun';
  MontNameLong = 'June';
elseif(MonthNo = 7);
  MonthName = 'Jul';
  MontNameLong = 'July';
elseif(MonthNo = 8);
  MonthName = 'Aug';
  MontNameLong = 'August';
elseif(MonthNo = 9);
  MonthName = 'Sep';
  MontNameLong = 'September';
elseif(MonthNo = 10);
  MonthName = 'Oct';
  MontNameLong = 'October';
elseif(MonthNo = 11);
  MonthName = 'Nov';
  MontNameLong = 'November';
elseif(MonthNo = 12);
  MonthName = 'Dec';
  MontNameLong = 'December';
Else;
  MonthName = 'MonthNameErrorElse';
  MontNameLong = 'MonthNameErrorElse';
EndIf;
#endregion