#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****

#----------------------------------------------------------------------------------------------------------------------------
#Region # Process Summary
#----------------------------------------------------------------------------------------------------------------------------

#<Process Description>
# This process updates the GLAccount Dimension

#<Changes Log>
# V1 - 27/07/2022 - Jithu Varghese - CPM Group
#
#<Maintenance Log\>

#<Execute Method>
# Daily Schedule
#<Execute Method\>

#<Processes Executed>
# syProcessLogInitialise
# syProcessLogMessage
# syTITracker
#<Processes Executed\>

#<Execute Schedule>
# Scheduled daily
#<Execute Schedule\>

#<Estimated Run Time>
# ~3 secs
#<Estimated Run Time\>

#EndRegion # Process Summary

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Debugging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

 ENDIF ;
 
  sServer = 'Breville' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;



#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General


sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;



# constant
sDimName_Tgt = 'GLAccount';
sHierName_Tgt = 'GLAccount';


# Create BRGLAccount dim

If( DimensionExists( sDimName_Tgt ) = 0 );
  DimensionCreate( sDimName_Tgt );
EndIf;


# Create BRGLAccount Hierarchy

If( HierarchyExists( sDimName_Tgt, sHierName_Tgt ) = 0 );
  HierarchyCreate( sDimName_Tgt, sHierName_Tgt );
# Else;
 # HierarchyDeleteAllElements(sDimName_Tgt, sHierName_Tgt);
EndIf;


sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#End Region # Process control


# [Temporary] CSV File to update GLAccount Dimension
# sImportFolder = CellGets( 'syEnvironment' , 'Breville' ,'File Transfer Folder' ) ;
# sFileName = 'DimGLAccount.csv' ;
# sFile = sImportFolder |'\' | sFileName;


# file must exist
# IF( FileExists( sFile)=0);
#    ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage','The file '| sFile | ' does not exist');
#    ProcessBreak;
# ENDIF;

# ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage','Importing File: ' | sFile ) ;

# ~~~~~~~~~~ Prepare source 
# cFileSourceName = sFile;
# DataSourceType = 'CHARACTERDELIMITED';
# DataSourceNameForServer = sFile;
# DatasourceASCIIHeaderRecords=1;
# DatasourceASCIIDelimiter = ',' ;


#ODBC SQL Statement to update GLAccount dimension from Azure DataLake [ To Switch from CSV once Data lake is ready ]
#----------------------------------------------------------------------------------------------------------------------------

# SQL query

 sSQL = 'SET NOCOUNT ON; 
 SELECT  [CHARTOFACCOUNTS]
      ,[MAINACCOUNTID]
      ,[NAME]
      ,[MAINACCOUNTCATEGORY]
      ,[ACCOUNTCATEGORYDESCRIPTION]
  FROM [dbo].[MainAccount]';
						
DNS_Server = CellGetS( 'syEnvironment', 'Breville', 'ODBC DSN for DL'  );


# Data Source

 DataSourceType = 'ODBC' ;
 DatasourceNameForServer = DNS_Server ;
 DatasourceQuery = sSQL;

#~~~~~~~~~ Build dimension ~~~~~~~~~~~~~~~~
#-- Create a target dimesnion
If(DimensionExists( sDimName_Tgt  ) = 0 ) ;
   DimensionCreate( sDimName_Tgt  ) ;
Endif;


#-- Create a target dimension hieararchy
If(HierarchyExists(sDimName_Tgt, sHierName_Tgt) = 0);
   HierarchyCreate(sDimName_Tgt, sHierName_Tgt);
# Else;
#    HierarchyDeleteAllElements(sDimName_Tgt, sHierName_Tgt);
Endif;

# Create Top Hierarchy
sTopElement = 'All GLAccount';
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sTopElement, 'C' );
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'CM Accounts' , 'C' ) ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'Gross Sales CM' , 'N' ) ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'SKU Promo Costs CM' , 'N' ) ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'Rebates CM' , 'N' ) ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'COGS FX Variance CM' , 'N' ) ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'Cost of Goods Sold CM' , 'N' ) ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'Freight CM' , 'N' ) ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'Warranty CM' , 'N' ) ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'CM%' , 'N' ) ;
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'GM%' , 'N' ) ;

HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sTopElement , 'CM Accounts' , 1 ) ;

HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'CM Accounts' , 'Gross Sales CM' , 1 ) ;
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'CM Accounts' , 'SKU Promo Costs CM' , 1 ) ;
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'CM Accounts' , 'Rebates CM' , 1 ) ;
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'CM Accounts' , 'COGS FX Variance CM' , 1 ) ;
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'CM Accounts' , 'Cost of Goods Sold CM' , 1 ) ;
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'CM Accounts' , 'Freight CM' , 1 ) ;
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'CM Accounts' , 'Warranty CM' , 1 ) ;
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'CM Accounts' , 'CM%' , 0 ) ;
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'CM Accounts' , 'GM%' , 0 ) ;


# ~~~~~~~~~~ Create attribtues ~~~~~~~~~~~~~~~~~~~~
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'Description', 'S');
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'CodeCaption', 'A');


#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
sElName = vAccountID ;
sElParentName = vAccountCategory ;

if ( sElParentName @<>'' ) ;
      HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sElName , 'N' ) ;
      HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sElParentName , 'C' ) ;
      HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElParentName , sElName , 1 ) ;
      HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sTopElement , sElParentName , 1 ) ;
endif ;

if ( sElParentName @='' ) ;
      HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sElName , 'N' ) ;
      HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'No Account Category' , 'C' ) ;
      HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , 'No Account Category' , sElName , 1 ) ;
      HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sTopElement , 'No Account Category' , 1 ) ;
endif ;
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

# Add Attributes
sElName = vAccountID ;
sElParentName = vAccountCategory ;

ElementAttrPutS( vNAME , sDimName_Tgt , sHierName_Tgt , vAccountID , 'Description' );
ElementAttrPutS( vACCOUNTID | ' - ' | vNAME , sDimName_Tgt , sHierName_Tgt , vAccountID , 'CodeCaption' );
if ( sElParentName @<>'' ) ;
   ElementAttrPutS( vACCOUNTCATEGORYDESCRIPTION , sDimName_Tgt , sHierName_Tgt , vAccountCategory , 'Description' );
   ElementAttrPutS( vACCOUNTCATEGORY | ' - ' | vACCOUNTCATEGORYDESCRIPTION , sDimName_Tgt , sHierName_Tgt , vAccountCategory , 'CodeCaption' );
endif ;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully. Total records: ' | NumberToString (nRecordCountMetadata  )   ;
EndIf;

#logoutput( 'INFO', sMessage );
#ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#End Region # TI Tracker
#endregion