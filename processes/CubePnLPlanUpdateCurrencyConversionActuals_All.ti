#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

##Counter

nRecordCountData = nRecordCountData  + 1 ;


# Get Values for calculating Currency Conversions
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

sDataAUDBudget = CellGetN ( 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'Local Currency' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;
sMultiplyAUDBudget = CellGetN (  'BRExchangeRate', vBusinessUnit , vFiscalMonth , 'AUD-Budget' ,'Currency' ,  'FXRate') ;


 sDataAUDConstant = CellGetN ( 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'Local Currency' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;
 sMultiplyAUDConstant = CellGetN (  'BRExchangeRate', vBusinessUnit , vFiscalMonth , 'AUD-Constant' , 'Currency' , 'FXRate') ;


 sDataAUDMonthEnd = CellGetN ( 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'Local Currency' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;
 sMultiplyAUDMonthEnd = CellGetN (  'BRExchangeRate', vBusinessUnit , vFiscalMonth , 'AUD-MonthEnd' , 'Currency' , 'FXRate') ;


 sDataEURConstant = CellGetN ( 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'Local Currency' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;
 sMultiplyEURConstant = CellGetN (  'BRExchangeRate', vBusinessUnit , vFiscalMonth , 'EUR-Constant' , 'Currency' , 'FXRate') ;

 sDataUSDConstant = CellGetN ( 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'Local Currency' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;
 sMultiplyUSDConstant = CellGetN (  'BRExchangeRate', vBusinessUnit , vFiscalMonth , 'USD-Constant' , 'Currency' , 'FXRate') ;


 sDataAUDOutlook = CellGetN ( 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'Local Currency' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;
 sMultiplyAUDOutlook = CellGetN (  'BRExchangeRate', vBusinessUnit , vFiscalMonth , 'AUD-Outlook' ,'Currency' , 'FXRate') ;



# Calculate Currency
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

nAUDBudget =  sDataAUDBudget \ sMultiplyAUDBudget ;
nAUDConstant =  sDataAUDConstant \ sMultiplyAUDConstant ;
nAUDMonthEnd =  sDataAUDMonthEnd \ sMultiplyAUDMonthEnd ;
nEURConstant =  sDataEURConstant \ sMultiplyEURConstant ;
nUSDConstant =  sDataUSDConstant \ sMultiplyUSDConstant ;
nAUDOutlook =  sDataAUDOutlook \ sMultiplyAUDOutlook ;


## Update Values
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# ASCIIOutput( sTestFile, Numbertostring (nAUDConstant) , Numbertostring (sDataAUDConstant) , Numbertostring (sMultiplyAUDConstant) , 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'AUD-Constant' , vFiscalMonth , 'Actual' , vTheatre , 'Amount'  );


 CellPutN( nAUDBudget , 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'AUD-Budget' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;

 CellPutN( nAUDConstant , 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'AUD-Constant' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;

 CellPutN( nAUDMonthEnd , 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'AUD-MonthEnd' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;
 CellPutN( nEURConstant , 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'EUR-Constant' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;
 CellPutN( nUSDConstant , 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'USD-Constant' , vFiscalMonth , 'Actual' , vTheatre , 'Amount' ) ;

 CellPutN( nAUDOutlook , 'PnLPlan', vGLAccount , vCostCentre , vBusinessUnit , vSegment , vOPXComponent , 'AUD-Outlook' , vFiscalMonth , 'Actual' , vTheatre , 'Amount'  ) ;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****


            
#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully. Total records: ' | NumberToString (nRecordCountMetadata  )   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

if ( pBU @= '' ) ;
sBU = 'All BUs';
else ;
sBU = pBU ;
endif ;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pParameter01' , 'Version: ' | 'Actual' ,
   'pParameter02' , 'BU: ' | sBU ,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
