sDim = 'BusinessUnit' ;
if( pBU @<> '' & pBU @<> 'All Business Unit' ) ;
sMDX = '{ [' | sDim | '].[' | sDim | '].[' | pBU | '] }' ;
else ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
endif;
If ( SubsetExists ( sDim , sSub_Tgt ) = 1 ) ;
   SubsetDestroy ( sDim , sSub_Tgt ) ;
EndIf ;
SubsetCreatebyMDX ( sSub_Tgt , sMDX , pTemp  ) ;
SubsetMDXSet ( sDim , sSub_Tgt , '' ) ;
ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

