#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#----------------------------------------------------------------------------------------------------------------------------
#Region # Process Summary
#----------------------------------------------------------------------------------------------------------------------------

#<Process Description>
# This process updates cross-rates (USD-Budget and EUR-Budget  for all BUs in the cube BRExchangeRate

#<Changes Log>
# V1 - 14/02/2023 - Ankit Patel - Analytics - First draft
#<Maintenance Log\>

#<Execute Method>
# Daily Schedule
#<Execute Method\>

#<Processes Executed>
# syProcessLogInitialise
# syProcessLogMessage
# syTITracker
#<Processes Executed\>

#<Execute Schedule>
# Scheduled daily
#<Execute Schedule\>

#<Estimated Run Time>
# ~3 secs
#<Estimated Run Time\>

#EndRegion # Process Summary

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Debugging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';
  sTestFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | 'ExchangeRates.txt';

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

 ENDIF ;
 
  sServer = 'Breville' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;



#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General


# Create temp subsets and assign it to the view
cubeName = 'BRExchangeRate' ;
viewName = 'TempCrossFXData' ;
subName = viewName ;
temporary = 0 ; 


IF( ViewExists( cubeName , viewName ) = 1 ) ; 
 ViewDestroy ( cubeName , viewName ) ;
ENDIF;
ViewCreate(cubeName,viewName,temporary);
#ViewZeroOut(cubeName,viewName);

Dim01 = 'BusinessUnit';
#ALL

Dim02 = 'FiscalMonth';
#ALL

Dim03 = 'Currency';
If (SubsetExists(Dim03,subName)=1);
	SubsetDestroy(Dim03,subName);
EndIf;
SubsetCreate(Dim03,subName,temporary);
#SubsetElementInsert(Dim03,subName,'AUD-Budget',1);
#SubsetElementInsert(Dim03,subName,'EUR-Budget-Test',1);
#SubsetElementInsert(Dim03,subName,'USD-Budget-Test',2);
ViewSubsetAssign(cubeName,viewName,Dim03,subName);

Dim04 = 'Version';
#ALL


ViewExtractSkipCalcsSet ( cubeName , viewName , 1 ) ;
ViewExtractSkipRuleValuesSet ( cubeName , viewName , 1 ) ;
ViewExtractSkipZeroesSet ( cubeName , viewName , 0 ) ;

ViewZeroOut(cubeName,viewName);

#New View


cubeName = 'BRExchangeRate' ;
viewName = 'TempCrossFXDataOut' ;
subName = viewName ;
temporary = 0 ; 


IF( ViewExists( cubeName , viewName ) = 1 ) ; 
 ViewDestroy ( cubeName , viewName ) ;
ENDIF;
ViewCreate(cubeName,viewName,temporary);
#ViewZeroOut(cubeName,viewName);

Dim01 = 'BusinessUnit';
#ALL

Dim02 = 'FiscalMonth';
#ALL

Dim03 = 'Currency';
If (SubsetExists(Dim03,subName)=1);
	SubsetDestroy(Dim03,subName);
EndIf;
SubsetCreate(Dim03,subName,temporary);
SubsetElementInsert(Dim03,subName,'AUD-Budget',1);
#SubsetElementInsert(Dim03,subName,'EUR-Budget-Test',2);
#SubsetElementInsert(Dim03,subName,'USD-Budget-Test',3);
ViewSubsetAssign(cubeName,viewName,Dim03,subName);

Dim04 = 'Version';
#ALL


ViewExtractSkipCalcsSet ( cubeName , viewName , 1 ) ;
ViewExtractSkipRuleValuesSet ( cubeName , viewName , 1 ) ;
ViewExtractSkipZeroesSet ( cubeName , viewName , 0 ) ;







#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sMultiplyAUDBudget = CellGetN (  'BRExchangeRate', vBusinessUnit , vMonth , 'AUD-Budget' ,  'Currency' , 'FXRate') ;
sMultiplyEURBudget = CellGetN (  'BRExchangeRate', 'BDE' , vMonth , 'AUD-Budget' ,  'Currency' , 'FXRate') ;
sMultiplyUSDBudget = CellGetN (  'BRExchangeRate', 'BUS' , vMonth , 'AUD-Budget' ,  'Currency' , 'FXRate') ;
 
nUSDCrossRate = sMultiplyAUDBudget \ sMultiplyUSDBudget;
nEURCrossRate = sMultiplyAUDBudget \ sMultiplyEURBudget;

#CellPutN (nUSDCrossRate,  'BRExchangeRate', vBusinessUnit , vMonth , 'USD-Budget-Test' ,  'Currency' , 'FXRate');
#CellPutN (nEURCrossRate,  'BRExchangeRate', vBusinessUnit , vMonth , 'EUR-Budget-Test' ,  'Currency' , 'FXRate');

nRecordCountData = nRecordCountData + 1 ;




#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

#SubsetElementInsert(Dim03,subName,'EUR-Budget-Test',4);
#SubsetElementInsert(Dim03,subName,'USD-Budget-Test',5);
#ViewSubsetAssign(cubeName,viewName,Dim03,subName);


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully. Total records: ' | NumberToString ( nRecordCountData )   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#End Region # TI Tracker
#endregion