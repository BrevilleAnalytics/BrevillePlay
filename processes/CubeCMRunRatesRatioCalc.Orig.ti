#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****

#----------------------------------------------------------------------------------------------------------------------------
#Region # Process Summary
#----------------------------------------------------------------------------------------------------------------------------

#<Process Description>
# This process calculates ratios

#<Changes Log>
# V1 - 17/08/2022 - Jithu Varghese - CPM Group - First draft

#<Maintenance Log\>

#<Execute Method>
# Daily Schedule
#<Execute Method\>

#<Processes Executed>
# syProcessLogInitialise
# syProcessLogMessage
# syTITracker
#<Processes Executed\>

#<Execute Schedule>
# Scheduled daily
#<Execute Schedule\>

#<Estimated Run Time>
#  secs
#<Estimated Run Time\>

#EndRegion # Process Summary

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Debugging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';
  sTestFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | 'RunRatesData.txt';


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

 ENDIF ;
 
  sServer = 'Breville' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;



#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General


sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;

sSub_Tgt= '}System.Tgt.' | sUniqueName ;



sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#End Region # Process control



# Process Variables

# General
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  csProcess |'.'| sTimestamp | '.' | sRandomInt;
sSub_Src = '}System.Src.' | sUniqueName ;
sView_Src = '}System.Src.' | sUniqueName ;
sSub_Tgt = '}System.Tgt.' | sUniqueName ;
sView_Tgt = 'TmpCMRunRates' ;

# Constants
sSub_Tgt= '}System.Tgt.' | sUniqueName ;

ptemp = 1 ; 
# Create temp subsets and assign it to the view
sCub_Tgt = 'CMRunRates' ;
sStringMonth = 'Month' ;
sRatioDriver = NumberToString ( pnPeriods ) | sStringMonth ;

# Create temp cubeview
IF( ViewExists( sCub_Tgt , sView_Tgt ) = 1 ) ; 
 ViewDestroy ( sCub_Tgt, sView_Tgt ) ;
ENDIF;
ViewCreate( sCub_Tgt, sView_Tgt , ptemp ) ;

i_TabDim = 1 ;
While ( TabDim ( sCub_Tgt , i_TabDim ) @<> '' ) ;
   sDim = TabDim ( sCub_Tgt , i_TabDim ) ;

   If( sDim @= 'Product' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'BusinessUnit' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'Theatre' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'Version' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[' | pVersion | '] }' ;
   ElseIf( sDim @= 'FiscalMonth' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[No FiscalMonth] }' ;
   ElseIf( sDim @= 'CMRatioDrivers' ) ;
      sMDX = '{[' | sDim | '].[' | sDim | '].[Gross Sales] }' ;
   ElseIf( sDim @= 'Currency' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[Local Currency] }' ;
   ElseIf( sDim @= 'CMRunRatesMeasure' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[' | sRatioDriver | '] }' ;
   Else ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   EndIf ;

   SubsetCreateByMDX ( sSub_Tgt , sMDX , ptemp ) ;
   SubsetMDXSet (sDim , sSub_Tgt , '' ) ;
   ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

i_TabDim = i_TabDim + 1 ;
End ;


ViewExtractSkipCalcsSet ( sCub_Tgt , sView_Tgt , 1 ) ;
ViewExtractSkipRuleValuesSet ( sCub_Tgt , sView_Tgt , 0 ) ;
ViewExtractSkipZeroesSet ( sCub_Tgt , sView_Tgt , 1 ) ;

DataSourceType = 'VIEW' ;
DataSourceNameForServer = sCub_Tgt ;
DataSourceCubeview = sView_Tgt ;


#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

##Counter

nRecordCountData = nRecordCountData  + 1 ;

## Process Function

sStringMonth = 'Month' ;
sRatioDriver = NumberToString ( pnPeriods ) | sStringMonth ;

# Get Values for calculating Ratios

sGrossSales = CellGetN( 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Gross Sales' , 'Local Currency' , sRatioDriver );

sNetShipments = CellGetN( 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Net Shipments' , 'Local Currency' , sRatioDriver );

sReturnedUnits = CellGetN( 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Returned Units' , 'Local Currency' , sRatioDriver );

sShippedUnits = CellGetN( 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Shipped Units' , 'Local Currency' , sRatioDriver  );

sRebates = CellGetN( 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Rebates' , 'Local Currency' , sRatioDriver  );

sCOGS = CellGetN( 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Cost of Goods Sold' , 'Local Currency' , sRatioDriver  );

sWarranty = CellGetN( 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Warranty' , 'Local Currency' , sRatioDriver  );

sFreight = CellGetN( 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Freight' , 'Local Currency' , sRatioDriver  );

# Calculate Ratios
if ( sReturnedUnits <> 0 % sShippedUnits <> 0 ) ;
   sReturn% = ABS ( sReturnedUnits  / sShippedUnits )  ; 
endif;

if ( sGrossSales <> 0 % sNetShipments <> 0 ) ;
  sASP = ABS ( sGrossSales / sNetShipments ) ;
endif ;

if ( sGrossSales <> 0 % sRebates <> 0 ) ;
  sRebate% = ABS ( sRebates / sGrossSales ) ;
endif ;

if ( sCOGS <> 0 % sShippedUnits <> 0 ) ;
   sCOGSUnitCost = ABS ( sCOGS / sShippedUnits ) ;
endif ;

if ( sWarranty <> 0 % sShippedUnits <> 0 ) ;
   sWarrantyUnitCost = ABS ( sWarranty / sShippedUnits ) ;
endif ;

if ( sFreight <> 0 % sShippedUnits <> 0 ) ;
  sFreightUnitCost = ABS ( sFreight / sShippedUnits ) ;
endif ; 

 if ( sReturnedUnits <> 0 % sShippedUnits <> 0 ) ;
   CellPutN( sReturn% , 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Baseline Return %' , 'Local Currency' , sRatioDriver ) ;
   ASCIIOutput( sTestFile, vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Baseline Return %' , 'Local Currency' , sRatioDriver );

 endif ;

 CellPutN( sASP , 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Average Selling Price' , 'Local Currency' , sRatioDriver  );
 CellPutN( sRebate% , 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Rebate %' , 'Local Currency' , sRatioDriver );
 CellPutN( sCOGSUnitCost , 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'COGS Unit Cost' , 'Local Currency' , sRatioDriver  );
 CellPutN( sWarrantyUnitCost , 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Warranty Unit Cost' , 'Local Currency' , sRatioDriver );
 CellPutN( sFreightUnitCost , 'CMRunRates', vProduct, vBusinessUnit , vTheatre , pVersion, 'No FiscalMonth' , 'Freight Unit Cost' , 'Local Currency' , sRatioDriver  );

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****


            
#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully. Total records: ' | NumberToString (nRecordCountMetadata  )   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

if ( pBU @= '' ) ;
sBU = 'All BUs';
else ;
sBU = pBU ;
endif ;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,

     'pParameter01' , 'Ratio Driver: ' | sRatioDriver ,
     'pParameter02' , 'Version: ' | pVersion ,
     'pParameter03' , 'BU: ' | sBU ,

   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#End Region # TI Tracker
#endregion