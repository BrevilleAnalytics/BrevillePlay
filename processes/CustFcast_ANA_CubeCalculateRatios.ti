# Create temp subsets and assign it to the view
# sCub_Tgt = 'CMRunRates' ;
# sStringMonth = 'Month' ;
# sRatioDriver = NumberToString ( pnPeriods ) | sStringMonth ;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****



# Get Values for calculating Ratios
 sNetSales3 	  = CellGetN( sCube, ProductCustFcast, CustomerCustFcast, BusinessUnit , Theatre , 'Actual', 'Last 3 Months' , 'Local' , 'Net Sales' );
 sCM3	      = CellGetN( sCube, ProductCustFcast, CustomerCustFcast, BusinessUnit , Theatre , 'Actual', 'Last 3 Months' , 'Local' , 'Contribution Margin' );
 sShippedUnits3 = CellGetN( sCube, ProductCustFcast, CustomerCustFcast,  BusinessUnit , Theatre , 'Actual', 'Last 3 Months' , 'Local' , 'Shipped Units' );

 sNetSales6      = CellGetN( sCube, ProductCustFcast, CustomerCustFcast, BusinessUnit , Theatre , 'Actual', 'Last 6 Months' , 'Local' , 'Net Sales' );
 sCM6	      = CellGetN( sCube, ProductCustFcast, CustomerCustFcast, BusinessUnit , Theatre , 'Actual', 'Last 6 Months' , 'Local' , 'Contribution Margin' );
 sShippedUnits6 = CellGetN( sCube, ProductCustFcast, CustomerCustFcast,  BusinessUnit , Theatre , 'Actual', 'Last 6 Months' , 'Local' , 'Shipped Units' );


 # Calculate Ratios
 sNetSalesPerUnit3 = ABS ( sNetSales3 \ sShippedUnits3 ) ;
 sNetSalesPerUnit6 = ABS ( sNetSales6 \ sShippedUnits6 ) ;

#Put the calculated value in the cell
CellPutN ( sNetSalesPerUnit3 , sCube, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre , 'Actual','Last 3 Months' , 'Local' , 'Net Sales per Unit'  );  
CellPutN ( sNetSalesPerUnit6 , sCube, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre , 'Actual','Last 6 Months' , 'Local' , 'Net Sales per Unit'  );  

#Get the Value from the All Customer Total
sNetSalesPerUnitAllCustomers3 = CellGetN( sCube, ProductCustFcast, 'All CustomerCustFcast',  BusinessUnit , Theatre , 'Actual', 'Last 3 Months' , 'Local' , 'Net Sales per Unit' );
sNetSalesPerUnitAllCustomers6 = CellGetN( sCube, ProductCustFcast, 'All CustomerCustFcast',  BusinessUnit , Theatre , 'Actual', 'Last 6 Months' , 'Local' , 'Net Sales per Unit' );
#Compare which to use
#  if( sNetSalesPerUnit = 0);
#  sNetSalesPerUnitToUse = sNetSalesPerUnitAllCustomers;
#  else;
#  sNetSalesPerUnitToUse = sNetSalesPerUnit;
#  endif;

# Put Ratio in Forecast Scenario (Unspread)
 if( sNetSalesPerUnit3 = 0)  ;
           CellPutN ( sNetSalesPerUnitAllCustomers3 , sCube, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre , 'Forecast', 'Last 3 Months'  , 'Local' , 'Net Sales per Unit'  );
           else;
           CellPutN ( sNetSalesPerUnit3 , sCube, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre , 'Forecast', 'Last 3 Months'  , 'Local' , 'Net Sales per Unit'  );
           endif;

 if( sNetSalesPerUnit6 = 0)  ;
           CellPutN ( sNetSalesPerUnitAllCustomers6 , sCube, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre , 'Forecast', 'Last 6 Months'  , 'Local' , 'Net Sales per Unit'  );
           else;
           CellPutN ( sNetSalesPerUnit6 , sCube, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre , 'Forecast', 'Last 6 Months'  , 'Local' , 'Net Sales per Unit'  );
            endif;

#ASCIIOutput( sTestFile, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre, vVersionCustFcast ,vMonthCustFcast , Currency ,  CustFcastMeasure ,NumberToString( Value ));
#  ASCIIOutput( sTestFile,ProductCustFcast,NumberToString(  sNetSalesPerUnitAllCustomers ));



# Spread Ratio to all Forecast Months
 sSub_OM = 'FcastMonths';
 nSubMthSize = SubsetGetSize( 'MonthCustFcast', sSub_OM );

  # IF(1=0);

   i = 1 ;
       While ( i <= nSubMthSize ) ;
          sMonths = SubsetGetElementName ( 'MonthCustFcast' , sSub_OM , i ) ; 
# Put Values into cube (if no history; use value at All Stats Group Level)
           if( sNetSalesPerUnit3 = 0)  ;
           CellPutN ( sNetSalesPerUnitAllCustomers3 , sCube, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre , 'Forecast', sMonths , 'Local' , 'Net Sales per Unit'  );
           else;
           CellPutN ( sNetSalesPerUnit3 , sCube, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre , 'Forecast', sMonths , 'Local' , 'Net Sales per Unit'  );
           endif;
#          ASCIIOutput( sTestFile, ProductCustFcast, CustomerCustFcast , BusinessUnit , Theatre, VersionCustFcast , MonthCustFcast , Currency , MeasureCustFcast , NumberToString( sNetSalesPerUnitToUse ) );
#          ASCIIOutput( sTestFile,NumberToString(  sNetSalesPerUnitAllCustomers3 ));
   i = i + 1 ;
      End ;


#endregion
