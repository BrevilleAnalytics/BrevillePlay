#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Debugging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'BrevillePlay', 'Temp Folder') | '\' | GetProcessName() | '.txt';
  sTestFile = CellGetS( 'syEnvironment', 'BrevillePlay', 'Temp Folder') | '\' | 'BSStgActuals.txt';

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

 ENDIF ;
 
  sServer = 'BrevillePlay' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;




#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General


sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;

sSub_Tgt= '}System.Tgt.' | sUniqueName ;



sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#End Region # Process control


# Process Variables

# General
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  csProcess |'.'| sTimestamp | '.' | sRandomInt;
sSub_Src = '}System.Src.' | sUniqueName ;
sView_Src = '}System.Src.' | sUniqueName ;
sSub_Tgt = '}System.Tgt.' | sUniqueName ;
sView_Tgt = 'TmpBSStgActuals' ;
sLogMessage ='';

# Constants
sSub_Tgt= '}System.Tgt.' | sUniqueName ;
sCub_Tgt = 'BSStgActuals' ;

#-- Set the period range to update 
#-- the period range 
# sFiscalMonth = DimensionElementPrincipalName( 'FiscalMonth', CellGetS( 'BRAsVersion', 'Actual', 'Actual Month'));
# nPeriodIndex_End = StringToNumber(ATTRS('FiscalMonth', sFiscalMonth, 'PeriodIndex'));
# nPeriodIndex_Start = nPeriodIndex_End - pnPeriodsUpdate;
# sFiscalMonth_Start = DimensionElementPrincipalName( 'FiscalMonth', FILL( '0', 10 - LONG(NumberToString(nPeriodIndex_Start))) | NumberToString(nPeriodIndex_Start));



# if ( pBU @<> '' ) ;
# sTheatre = ATTRS( 'BusinessUnit', pBU , 'OPXTheatre' ) ;
# endif ;

# if ( sTheatre @= 'APAC' ) ;
# sFiscalMonth = DimensionElementPrincipalName( 'FiscalMonth', CellGetS( 'BRAsVersion', 'NoVersion', 'APAC Actual Month'));
# endif ;

# if ( sTheatre @= 'EMEA' ) ;
# sFiscalMonth = DimensionElementPrincipalName( 'FiscalMonth', CellGetS( 'BRAsVersion', 'NoVersion', 'EMEA Actual Month'));
# endif ;

# if ( sTheatre @= 'Americas' ) ;
# sFiscalMonth = DimensionElementPrincipalName( 'FiscalMonth', CellGetS( 'BRAsVersion', 'NoVersion', 'Americas Actual Month'));
# endif ;

# if ( sTheatre @= 'Corporate' ) ;
# sFiscalMonth = DimensionElementPrincipalName( 'FiscalMonth', CellGetS( 'BRAsVersion', 'NoVersion', 'Corporate Actual Month'));
# endif ;


# sCurrentMonth = ATTRS( 'FiscalMonth', sFiscalMonth , 'CalendarMonth' ) ;

#ODBC SQL Statement to update historical CM sales data by month cube CMStgActuals from Azure DataLake
#----------------------------------------------------------------------------------------------------------------------------
 DataSourceType = 'ODBC';


# SQL query

 sSQL = 'SET NOCOUNT ON; 
SELECT [MonthName]
       ,CASE WHEN Right([GLAccount],1) in (''A'',''B'')
	   THEN substring([GLAccount],1, len([GLAccount])-1)
	   ELSE GLAccount 
	   END as GLAccount
      ,[businessUnit]
      ,[AccountingCurrencyAmount]
      ,[RunningFYAccountingCurrencyAmount]
      ,[TransactionCurrencyAmount]
      ,RunningFYTransactionCurrencyAmount
  FROM [dbo].[vw_GL_BS_D365_2]';
#where[monthYear] = ''' |sCurrentMonth| ''' and [businessUnit] = ''' |pBU| '''
#where [MonthName] = "July 2022" and [businessUnit] = ''' |pBU| ''' ;

 
		
DNS_Server = CellGetS( 'syEnvironment', 'Breville', 'ODBC DSN for DL SQL'  );


# Data Source

 DataSourceType = 'ODBC' ;
 DatasourceNameForServer = DNS_Server ;
 DatasourceQuery = sSQL;
 
# Create temp cubeview
IF( ViewExists( sCub_Tgt , sView_Tgt ) = 1 ) ; 
 ViewDestroy ( sCub_Tgt, sView_Tgt ) ;
ENDIF;
ViewCreate( sCub_Tgt, sView_Tgt , 1 ) ;


# Create temp subsets and assign it to the view

i_TabDim = 1 ;
While ( TabDim ( sCub_Tgt , i_TabDim ) @<> '' ) ;
   sDim = TabDim ( sCub_Tgt , i_TabDim ) ;

   If( sDim @= 'GLAccount' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'BusinessUnit' ) ;
#       sMDX = '{ [' | sDim | '].[' | sDim | '].[' | pBU | '] }' ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'FiscalMonth' ) ;
#       sMDX = '{ [' | sDim | '].[' | sDim | '].[' | sFiscalMonth| '] }' ;
   sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   ElseIf( sDim @= 'BSComponent' ) ;
       sMDX = '{ [' | sDim | '].[' | sDim | '].[' | 'Calculated'| '] }' ;
   ElseIf( sDim @= 'BSStgActualsMeasure' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;  
   Else ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
   EndIf ;

   SubsetCreateByMDX ( sSub_Tgt , sMDX , 1 ) ;
   SubsetMDXSet (sDim , sSub_Tgt , '' ) ;
   ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

i_TabDim = i_TabDim + 1 ;
End ;

#------ View zero out
ViewZeroOut(sCub_Tgt, sView_Tgt);

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

# sMonth = SUBST( vMonth , 1 , 3 );
# sYear = SUBST ( vMonth, LONG (vMonth) -4 +1 , 4);
# sPeriod = 'F' | sYear | '-' | sMonth ;

sPeriod = ATTRS( 'CalendarMonth', vMonthName , 'FiscalMonth' );

#~~~~~~~~~ set validation ~~~~~~~~~~
#~~~ check if element exists
# Customer
sDim = 'GLAccount' ;
sEl = vGLAccount ;
If (DIMIX( sDim, sEl  ) = 0  ) ;
  sMessage = 'Account = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

# BU
sDim = 'BusinessUnit' ;
sEl = vBusinessUnit ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'BusinessUnit = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

sDim = 'FiscalMonth' ;
sEl = sPeriod ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'FiscalMonth = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;


If ( SUBST( vGLAccount, 1, 1) @= '2' % SUBST( vGLAccount, 1, 1) @='3' % vGLAccount @= '400101'% vGLAccount @= '500102' );   
    vRunningFYAccountingCurrencyAmount = vRunningFYAccountingCurrencyAmount*-1 ;
EndIf; 

If ( SUBST( vGLAccount, 1, 1) @= '2' % SUBST( vGLAccount, 1, 1) @='3' % vGLAccount @= '400101'% vGLAccount @= '500102' );   
    vRunningFYTransactionCurrencyAmount = vRunningFYTransactionCurrencyAmount*-1 ;
EndIf; 

If (vGLAccount @= '400101'% vGLAccount @= '500102' );   
    vAccountingCurrencyAmount = vAccountingCurrencyAmount*-1 ;
    vTransactionCurrencyAmount = vTransactionCurrencyAmount*-1 ;
EndIf; 

ASCIIOutput( sTestFile, NumberToString(vAccountingCurrencyAmount) , sCub_Tgt ,vGLAccount , vBusinessUnit , 'AUD-MonthEnd' , sPeriod , 'Calculated' , 'Movement');

CellIncrementN( vAccountingCurrencyAmount , sCub_Tgt ,vGLAccount , vBusinessUnit , 'AUD-MonthEnd' , sPeriod , 'Calculated' , 'Movement' );
CellIncrementN( vRunningFYAccountingCurrencyAmount , sCub_Tgt ,vGLAccount , vBusinessUnit , 'AUD-MonthEnd' , sPeriod , 'Calculated' , 'Balance' );
CellIncrementN( vTransactionCurrencyAmount , sCub_Tgt ,vGLAccount , vBusinessUnit , 'Local' , sPeriod , 'Calculated' , 'Movement' );
CellIncrementN( vRunningFYTransactionCurrencyAmount , sCub_Tgt ,vGLAccount , vBusinessUnit , 'Local' , sPeriod , 'Calculated' , 'Balance' );


nRecordCountData = nRecordCountData + 1 ;
#endregion
#region Epilog
            
#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Executed by: ' | sUSer |'. Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Executed by: ' | sUSer |'. Process completed successfully. Total records: ' | NumberToString ( nRecordCountData )   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference, 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     #sSystemMessage = 'Successful';
     sSystemMessage = 'Executed by: ' | sUSer |'. Process completed successfully';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#End Region # TI Tracker
#endregion