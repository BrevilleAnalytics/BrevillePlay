#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****

#----------------------------------------------------------------------------------------------------------------------------
#Region # Process Summary
#----------------------------------------------------------------------------------------------------------------------------

#<Process Description>
# This process updates the EmployeeID Dimension 

#<Changes Log>
# V1 - 03/11/2022 - Jithu Varghese - CPM Group - 1st Draft
#
#<Maintenance Log\>

#<Execute Method>
# Daily Schedule
#<Execute Method\>

#<Processes Executed>
# syProcessLogInitialise
# syProcessLogMessage
# syTITracker
#<Processes Executed\>

#<Execute Schedule>
# Scheduled daily
#<Execute Schedule\>

#<Estimated Run Time>
# ~3 secs
#<Estimated Run Time\>

#EndRegion # Process Summary

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Debugging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

 ENDIF ;
 
  sServer = 'Breville' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;



#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General


sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;

sSub_Tgt= '}System.Tgt.' | sUniqueName ;


# constant
sDimName_Tgt = 'EmployeeID';
sHierName_Tgt = 'EmployeeID';


sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#End Region # Process control


#  CSV File to update EmployeeID Dimension
sImportFolder = CellGets( 'syEnvironment' , 'Breville' ,'PIISourceFiles Folder' ) ;
sFileName = 'WFEmployeeMasterData.csv' ;
sFile = sImportFolder |'\' | sFileName;


# file must exist
IF( FileExists( sFile)=0);
   ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage','The file '| sFile | ' does not exist');
   ProcessBreak;
ENDIF;

ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage','Importing File: ' | sFile ) ;

# ~~~~~~~~~~ Prepare source 
cFileSourceName = sFile;
DataSourceType = 'CHARACTERDELIMITED';
DataSourceNameForServer = sFile;
DatasourceASCIIHeaderRecords=8;
DatasourceASCIIDelimiter = ',' ;



#~~~~~~~~~ Build dimension ~~~~~~~~~~~~~~~~
#-- Create a target dimesnion
If(DimensionExists( sDimName_Tgt  ) = 0 ) ;
   DimensionCreate( sDimName_Tgt  ) ;
Endif;


#-- Create a target dimension hieararchy
If(HierarchyExists(sDimName_Tgt, sHierName_Tgt) = 0);
   HierarchyCreate(sDimName_Tgt, sHierName_Tgt);
   HierarchySortOrder( sDimName_Tgt, sHierName_Tgt , 'By Name', 'Ascending', 'By Hierarchy', 'Ascending' );
Else;
   HierarchyDeleteAllElements(sDimName_Tgt, sHierName_Tgt);
Endif;

# Create Top Hierarchy
sTopElement = 'All Employees';
HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sTopElement, 'C' ) ;

# ~~~~~~~~~~ Create attribtues ~~~~~~~~~~~~~~~~~~~~
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'EmployeeName', 'S') ;
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'CodeCaption', 'A') ;
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'EmployeeMail', 'S') ;
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'ManagerName', 'S') ;
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'ManagerID', 'S');
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'EmployeeStatus', 'S') ;
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'EmployeeLocation', 'S') ;
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'EmployeeHireDate', 'S');
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'JobTitle', 'S') ;
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

sElName = vEmployeeID ;

if ( vEmployeeID @<> '' ) ;
      HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sElName , 'N' ) ;
      HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sTopElement , sElName , 1 ) ;
endif ;


      
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

sElName = vEmployeeID ;

# Add Attributes

ElementAttrPutS ( vEmployeeName , sDimName_Tgt , sHierName_Tgt , sElName  , 'EmployeeName' ) ;
ElementAttrPutS( vEmployeeID | ' - ' | vEmployeeName, sDimName_Tgt , sHierName_Tgt , sElName  , 'CodeCaption' ) ;
ElementAttrPutS ( vEmployeemail , sDimName_Tgt , sHierName_Tgt , sElName  , 'EmployeeMail' ) ;
ElementAttrPutS( vManagerName , sDimName_Tgt , sHierName_Tgt , sElName  , 'ManagerName' ) ;
ElementAttrPutS ( vManagerID , sDimName_Tgt , sHierName_Tgt , sElName  , 'ManagerID' ) ;
ElementAttrPutS( vEmployeeStatus , sDimName_Tgt , sHierName_Tgt , sElName  , 'EmployeeStatus' ) ;
ElementAttrPutS ( vEmployeeLocation , sDimName_Tgt , sHierName_Tgt , sElName  , 'EmployeeLocation' ) ;
ElementAttrPutS( vEmployeeHireDate , sDimName_Tgt , sHierName_Tgt , sElName  , 'EmployeeHireDate' ) ;
ElementAttrPutS ( vEmpJobTitle , sDimName_Tgt , sHierName_Tgt , sElName  , 'JobTitle' ) ;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully.' | NumberToString (nRecordCountMetadata  )   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#End Region # TI Tracker
#endregion