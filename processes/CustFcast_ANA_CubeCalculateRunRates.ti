sDimName = 'MonthCustFcast';
sDimNameAttr = 'Last3Months';

#Put the 3,6 month run rates in db

#vCurrentMonth = Month(Today(1));  
vCurrentMonth = 3; 

#ASCIIOutput( sTestFile,NumberToString(  vCurrentMonth ));

# If Version is Actual and Last 3 months Flagged on MonthCustFcast and Current Month is greater than MonthNumber then increment the value for last 3 months:
if (vVersionCustFcast @= 'Actual' &  ATTRN('MonthCustFcast', vMonthCustFcast, 'Last3Months') = 1  & vCurrentMonth > ATTRN('MonthCustFcast', vMonthCustFcast, 'MonthNumber'));
CellIncrementN(Value, sCub_Tgt, ProductCustFcast, CustomerCustFcast, BusinessUnit, Theatre, 'Actual', 'Last 3 Months', 'Local', MeasureCustFcast);
#Else if Version is Prior Year and Last 3 months Flagged on MonthCustFcast and Current Month is less than MonthNumber then increment the value:
elseif (vVersionCustFcast @= 'Prior Year' &  ATTRN('MonthCustFcast', vMonthCustFcast, 'Last3Months') = 1  & vCurrentMonth < ATTRN('MonthCustFcast', vMonthCustFcast, 'MonthNumber')); 
CellIncrementN(Value, sCub_Tgt, ProductCustFcast, CustomerCustFcast, BusinessUnit, Theatre, 'Actual', 'Last 3 Months', 'Local', MeasureCustFcast);
endif;
 

# If Version is Actual and Last 6 months Flagged on MonthCustFcast and Current Month is greater than MonthNumber then increment the value for last 6 months from Actual Scenario:
if (vVersionCustFcast @= 'Actual' &  ATTRN('MonthCustFcast', vMonthCustFcast, 'Last6Months') = 1  & vCurrentMonth > ATTRN('MonthCustFcast', vMonthCustFcast, 'MonthNumber'));
CellIncrementN(Value, sCub_Tgt, ProductCustFcast, CustomerCustFcast, BusinessUnit, Theatre, 'Actual', 'Last 6 Months', 'Local', MeasureCustFcast);
#Else if Version is Prior Year and Last 6 months Flagged on MonthCustFcast and Current Month is less than MonthNumber then increment the value for last 6 months from Prior Year Scenario:
elseif (vVersionCustFcast @= 'Prior Year' &  ATTRN('MonthCustFcast', vMonthCustFcast, 'Last6Months') = 1  & vCurrentMonth < ATTRN('MonthCustFcast', vMonthCustFcast, 'MonthNumber'));  
CellIncrementN(Value, sCub_Tgt, ProductCustFcast, CustomerCustFcast, BusinessUnit, Theatre, 'Actual', 'Last 6 Months', 'Local', MeasureCustFcast);
endif;





