#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****

#This process should be run after loading Actuals - it clears runs rates and recalculates then calculates ratios and spreads to Forecast months

sTestFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | 'CustFcastRunRates.txt';

# Clear data from target cube
# Create temp cubeview for clearing existing run rates before recalculating
sCub_Tgt = 'CustomerForecast' ;
sView_Tgt = 'CustClearRunRatesTemp' ;
sSub_Tgt = 'CustClearRunRatesTemp' ;
pTemp = 1; 

IF( ViewExists( sCub_Tgt , sView_Tgt ) = 1 ) ; 
 ViewDestroy ( sCub_Tgt, sView_Tgt ) ;
ENDIF;
ViewCreate( sCub_Tgt, sView_Tgt , pTemp ) ;

i_TabDim = 1 ;
While ( TabDim ( sCub_Tgt , i_TabDim ) @<> '' ) ;
   sDim = TabDim ( sCub_Tgt , i_TabDim ) ;

  If( sDim @= 'ProductCustFcast' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  ElseIf( sDim @= 'CustomerCustFcast' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;    
  ElseIf( sDim @= 'BusinessUnit' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  ElseIf( sDim @= 'Theatre' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  ElseIf( sDim @= 'VersionCustFcast' ) ;
     sMDX = '{ [' | sDim | '].[' | sDim | '].[Actual] }' ;
  ElseIf( sDim @= 'MonthCustFcast' ) ;
     sMDX = '{ [' | sDim | '].[' | sDim | '].[Last 3 Months],
               [' | sDim | '].[' | sDim | '].[Last 6 Months]}' ; 
  ElseIf( sDim @= 'Currency' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[Local Currency] }' ; 
  ElseIf( sDim @= 'MeasureCustFcast' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[Contribution Margin],
                [' | sDim | '].[' | sDim | '].[Shipped Units],
                [' | sDim | '].[' | sDim | '].[Returned Units],
                [' | sDim | '].[' | sDim | '].[Net Sales],
                [' | sDim | '].[' | sDim | '].[Net Sales per Unit]}';
#  Else ;
    #  sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  EndIf ;

If (SubsetExists ( sDim, sSub_Tgt ) <> 0 );
      SubsetDestroy( sDim, sSub_Tgt );
  endif;
  
   SubsetCreateByMDX ( sSub_Tgt , sMDX ,sDim, pTemp ) ;
   SubsetMDXSet (sDim , sSub_Tgt , '' ) ;
   ViewSubsetAssign (sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

i_TabDim = i_TabDim + 1 ;
End ;

 ViewZeroOut(sCub_Tgt, sView_Tgt);


# Create temp cubeview for Source of this processes
sCube = 'CustomerForecast';
sSub = 'Cust3MthRRTemp' ;
sView = 'Cust3MthRRTemp' ;
pTemp = 0 ; 

If ( ViewExists ( sCube , sView ) <> 0 ) ;
   ViewDestroy ( sCube , sView ) ;
EndIf ;
ViewCreate ( sCube , sView , pTemp ) ;

i_TabDim = 1 ;
While ( TabDim ( sCub_Tgt , i_TabDim ) @<> '' ) ;
   sDim = TabDim ( sCub_Tgt , i_TabDim ) ;

  If( sDim @= 'ProductCustFcast' ) ;
     sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
#          sMDX = '{ [' | sDim | '].[' | sDim | '].[BBL002SIL0NUC1] ,
#          [' | sDim | '].[' | sDim | '].[BBL605BSS1BCA1] }' ;
  ElseIf( sDim @= 'CustomerCustFcast' ) ;
     # sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
    sMDX = '{ DRILLDOWNMEMBER(TM1FILTERBYLEVEL(TM1SUBSETALL([CustomerCustFcast]) , 1) , {[CustomerCustFcast].[CustomerCustFcast].[All CustomerCustFcast]} , RECURSIVE) }' ;  
     ElseIf( sDim @= 'BusinessUnit' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  ElseIf( sDim @= 'Theatre' ) ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  ElseIf( sDim @= 'VersionCustFcast' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[Actual] ,
                [' | sDim | '].[' | sDim | '].[Prior Year] ,
                [' | sDim | '].[' | sDim | '].[Forecast] }' ;
  ElseIf( sDim @= 'MonthCustFcast' ) ;
      sMDX = '{DISTINCT({[MonthCustFcast].[MonthCustFcast].[Financial Year], DESCENDANTS([MonthCustFcast].[MonthCustFcast].[Financial Year], 99 , LEAVES)})}';
#       sMDX = '{ [' | sDim | '].[' | sDim | '].[Jul],
#                 [' | sDim | '].[' | sDim | '].[Aug],
#                 [' | sDim | '].[' | sDim | '].[Sep]}';
  ElseIf( sDim @= 'Currency' ) ;
      sMDX = '{ [' | sDim | '].[' | sDim | '].[Local Currency] }' ; 
  ElseIf( sDim @= 'MeasureCustFcast' ) ;
       sMDX = '{ [' | sDim | '].[' | sDim | '].[Contribution Margin],
                 [' | sDim | '].[' | sDim | '].[Shipped Units],
                 [' | sDim | '].[' | sDim | '].[Returned Units],
                 [' | sDim | '].[' | sDim | '].[Net Sales] }';
  Else ;
      sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  EndIf ;

 If (SubsetExists ( sDim, sSub) <> 0 );
      SubsetDestroy( sDim, sSub );
  endif;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

i_TabDim = i_TabDim + 1 ;
End ;

ViewExtractSkipCalcsSet ( sCube , sView , 1 ) ;  
# 0 = take data at consolidation
ViewExtractSkipRuleValuesSet ( sCube , sView , 0 ) ;
#0 = take rule result as data
ViewExtractSkipZeroesSet ( sCube , sView , 1  ) ;
#1 = skip zeros

# Assign Datasource
DataSourceType = 'VIEW' ;
DataSourceNameForServer = sCube ;
DataSourceCubeview = sView ;


