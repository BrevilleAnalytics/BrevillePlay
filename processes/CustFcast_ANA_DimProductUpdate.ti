DataSourceType = 'ODBC';


# SQL query

 sSQL = 'SET NOCOUNT ON ; 
select 
Distinct itemcode,
parentcode,
category,
Portfolio,
HierarchyBrand, 
Segment,
BusinessUnit 
from DimProduct 
where itemcode <>'''' OR itemcode <> ''NULL''' ;
						

DNS_Server = CellGetS( 'syEnvironment', 'Breville', 'ODBC DSN for DL'  );


# Data Source

 DataSourceType = 'ODBC' ;
 DatasourceNameForServer = DNS_Server ;
 DatasourceQuery = sSQL;
 
 

sDimNameTrgt = 'ProductCustFcast';
#DimensionDeleteAllElements(sDimNameTrgt);

#~~~~~~~~~ Build dimension ~~~~~~~~~~~~~~~~
#-- Create a target dimesnion

# constant
sDimName_Tgt = 'ProductCustFcast';
sHierName_Tgt = 'ProductCustFcast';

 If(DimensionExists( sDimName_Tgt  ) = 0 ) ;
    DimensionCreate( sDimName_Tgt  ) ;
 Endif;


 #-- Create a target dimension hieararchy
 If(HierarchyExists(sDimName_Tgt, sHierName_Tgt) = 0);
    HierarchyCreate(sDimName_Tgt, sHierName_Tgt);
 Else;
    HierarchyDeleteAllElements(sDimName_Tgt, sHierName_Tgt);
 Endif;


# Create Top Parent in Hierarchy
sElTopParent = 'Root ' | sHierName_Tgt  ;
HierarchyElementInsert ( sDimName_Tgt, sHierName_Tgt, '',sElTopParent, 'C');
HierarchySortOrder( sDimName_Tgt,  sHierName_Tgt,  'ByName', 'Ascending','ByHierarchy', 'Ascending'); 

# Create 2 roots in Hierarchy
sElRegion = 'All' | sHierName_Tgt;
sElBrand = 'All Products by Brand';
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElTopParent , sElRegion , 1 ) ;
HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElTopParent , sElBrand , 1 ) ;
HierarchySortOrder( sDimName_Tgt,  sHierName_Tgt,  'ByName', 'Ascending','ByHierarchy', 'Ascending'); 

# ~~~~~~~~~~ Create attribtues ~~~~~~~~~~~~~~~~~~~~
# ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'Caption', 'S');
# ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'CodeCaption', 'A');

DimensionAttrDelete( 'BusinessUnit' );
DimensionAttrInsert( '', 'BusinessUnit','S' );
ElementAttrDelete( sDimName_Tgt, sHierName_Tgt,'BusinessUnit' );
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'BusinessUnit', 'S');

DimensionAttrDelete( 'Category' );
DimensionAttrInsert( '', 'Category','S' );
ElementAttrDelete( sDimName_Tgt, sHierName_Tgt,'Category' );
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'Category', 'S');

DimensionAttrDelete( 'Brand' );
DimensionAttrInsert( '', 'Brand','S' );
ElementAttrDelete( sDimName_Tgt, sHierName_Tgt,'Brand' );
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'Brand', 'S');

