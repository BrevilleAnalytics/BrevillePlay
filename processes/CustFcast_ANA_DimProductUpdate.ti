#HierarchyElementInsert( «DimName», «HierName», «InsertionPoint», «NewElName», «ElType» );
sElName = ItemCode ;


sELRegionParentName1 = BusinessUnit;
sElRegionParentName2 = Category ;

#Skip product called Nespresso as this causes item codes to be added twice (i.e. under 'Nespresso' itemcode and 'Nespresso' brand)
If (itemcode @= 'Nespresso');
itemskip;
#sElName = 'Nespresso SKU';
#Else;
#sElName = sElName ;

endif;


# Load all Leaf elements from file
      HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sElName , 'N' ) ;
      
# Insert Region Parents and assign to leavess if category and businessunit values are not blank
      if ( sELRegionParentName1 @<> '' & sElName @<> '' ) ;

         HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' ,  sELRegionParentName1 |'-'| sElRegionParentName2, 'C' ) ;
         HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sELRegionParentName1 | ' - ' | 'BusinessUnit' , 'C' ) ;
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sELRegionParentName1 |'-'| sElRegionParentName2, sElName , 1 ) ;
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sELRegionParentName1 | ' - ' | 'BusinessUnit', sELRegionParentName1 |'-'| sElRegionParentName2 , 1 ) ;
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElRegion , sELRegionParentName1 | ' - ' | 'BusinessUnit' , 1 ) ;
      endif ;

# Insert Region Parents and assign to leaves if businessunit values are blank
      if ( sELRegionParentName1 @= '' & sElName @<> '' ) ;

          HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' ,  sELRegionParentName1 |'-'| sElRegionParentName2, 'C' ) ;
          HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'No BusinessUnit' , 'C' ) ;    
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sELRegionParentName1 |'-'| sElRegionParentName2, sElName , 1 ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt ,'No BusinessUnit' , sELRegionParentName1 |'-'| sElRegionParentName2 , 1 ) ;
          HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElRegion , 'No BusinessUnit' , 1 ) ;
      endif ;

# Insert Region Parents and assign to leaves if category values are blank
      if ( sELRegionParentName1 @<> '' & sElName @= '' ) ;

         HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' ,  sELRegionParentName1 |'- No Category', 'C' ) ;
         HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sELRegionParentName1 | ' - ' | 'BusinessUnit' , 'C' ) ;
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sELRegionParentName1 |'- No Category', sElName , 1 ) ;
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sELRegionParentName1 | ' - ' | 'BusinessUnit', sELRegionParentName1 |'- No Category' , 1 ) ;
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElRegion , sELRegionParentName1 | ' - ' | 'BusinessUnit' , 1 ) ;
      endif ;



sElBrandParentName = HierarchyBrand;


# Insert Brand Parents and assign to leavess if not blank
      if ( sElBrandParentName @<> '' & sElName @<> '' ) ;

     #    HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , sElBrandParentName, 'C' ) ;
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt ,sElBrand, sElBrandParentName , 1 ) ;
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt ,sElBrandParentName, sElName , 1 ) ;
      endif ;

# Insert Brand Parents and assign to leaves if values are blank
      if ( sElBrandParentName @= '' & sElName @<> '' ) ;

         #HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'No Brand' , 'C' ) ;    
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElBrand , 'No Brand' , 1 ) ;
         HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt ,'No Brand', sElName , 1 ) ;
      endif ;




ElementAttrPutS(  BusinessUnit , sDimName_Tgt , sHierName_Tgt , sElName  , 'BusinessUnit'  );
ElementAttrPutS(  category , sDimName_Tgt , sHierName_Tgt , sElName  , 'Category'  );
ElementAttrPutS(  HierarchyBrand , sDimName_Tgt , sHierName_Tgt , sElName  , 'Brand'  );


#ElementAttrPutS( sElParentName2, sDimName_Tgt, sHierName_Tgt, sElParentName1 |'-'| sElParentName2,'Category');

if (sELRegionParentName1 @<> ''); 
ElementAttrPutS( 'All Categories', sDimName_Tgt, sHierName_Tgt, sELRegionParentName1 | ' - ' | 'BusinessUnit','Category');
endif;

if (sELRegionParentName1 @<> '' & sElRegionParentName2 @<> ''); 
ElementAttrPutS( 'All Brands', sDimName_Tgt, sHierName_Tgt, sELRegionParentName1 |'-'| sElRegionParentName2,'Brand');
endif;

if (sELRegionParentName1 @<> ''); 
ElementAttrPutS( 'All Brands', sDimName_Tgt, sHierName_Tgt, sELRegionParentName1 | ' - ' | 'BusinessUnit','Brand');
endif;
