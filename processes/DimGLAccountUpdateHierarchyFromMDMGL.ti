        #HierarchyElementInsert ( sDimName_Tgt, sHierName_Main, '',sElTopParentHierarchy1, 'C');

    #DimensionSortOrder
        # HierarchySortOrder( sDimName_Tgt,  sHierName_Tgt,  'ByName', 'Ascending','ByHierarchy', 'Ascending'); 
        # HierarchySortOrder( sDimName_Tgt,  sHierName_Tgt1,  'ByName', 'Ascending','ByHierarchy', 'Ascending'); 

