#Region Build dimension 
    #Create a target dimension
    
    # constant
    sDimName_Tgt = 'GLAccount';
    sHierName_Tgt = 'Management Reporting';
    sHierName_Tgt1 = 'BalanceSheet GLAccounts';
    sHierName_Main = 'GLAccount';
    
    If(DimensionExists( sDimName_Tgt  ) = 0 ) ;
       DimensionCreate( sDimName_Tgt  ) ;
    Endif;
