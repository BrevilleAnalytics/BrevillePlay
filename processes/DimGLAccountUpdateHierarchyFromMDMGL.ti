# Create temp cubeview
    IF( ViewExists( sCub_Src , sView_Src) = 1 ) ; 
        ViewDestroy ( sCub_Src, sView_Src ) ;
    ENDIF;
        ViewCreate( sCub_Src, sView_Src, 1 ) ;

# Create temp subsets and assign it to the view

    i_TabDim = 1 ;
    While ( TabDim ( sCub_Src , i_TabDim ) @<> '' ) ;
       sDim = TabDim ( sCub_Src , i_TabDim ) ;
    
       If( sDim @= 'GLAccount' ) ;
          sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
       ElseIf( sDim @= 'MDMGLMeasure' ) ;
          sMDX = '{ [' | sDim | '].[' | sDim | '].[Parent Level 1] }' ;
       Else ;
          sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
       EndIf ;
    
       SubsetCreateByMDX ( sSub_Src , sMDX , 1 ) ;
       SubsetMDXSet (sDim , sSub_Src , '' ) ;
       ViewSubsetAssign ( sCub_Src , sView_Src , sDim , sSub_Src ) ;
    
    i_TabDim = i_TabDim + 1 ;
    End ;
    
    ViewExtractSkipZeroesSet( sCub_Src, sView_Src, 0 ) ;
    ViewExtractSkipCalcsSet( sCub_Src, sView_Src, 1) ;
    ViewExtractSkipRuleValuesSet( sCub_Src, sView_Src, 0) ;

