# Endif;
#EndRegion

#Region - add Current Period Earnings to Retained Earnings - BS
    HierarchyElementInsert( sDimName_Tgt, sHierName_Main, '', 'Current Period Earnings', 'N' );
    HierarchyElementComponentAdd( sDimName_Tgt, sHierName_Main, 'Retained earnings - BS', 'Current Period Earnings', 1 );
#EndRegion

#Region Create Top Hierarchies
     sElTopParent = 'All ' | sHierName_Tgt  ;
     sElTopParent1 = 'All ' | sHierName_Tgt1  ;

        #sElTopParentHierarchy1 = 'All BalanceSheet GLAccounts';

