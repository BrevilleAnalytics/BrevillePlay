        # HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '' , 'EBIT%' , 'N' ) ;
        
        HierarchyElementInsert ( sDimName_Tgt , sHierName_Main , '' , 'CM%' , 'N' ) ;
        HierarchyElementInsert ( sDimName_Tgt , sHierName_Main , '' , 'GM%' , 'N' ) ;
        HierarchyElementInsert ( sDimName_Tgt , sHierName_Main , '' , 'EBIT%' , 'N' ) ;
        
        # HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElTopParent , 'CM%' , 0 ) ;
        # HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElTopParent , 'GM%' , 0 ) ;
