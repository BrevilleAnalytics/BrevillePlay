#CellPutN( COGS_Budget / sMultiplyAUDConstant, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Constant','Budget',vNow,'COGS per Unit');
CellPutN( COGS_WorkingOutlook / sMultiplyAUDConstant, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Constant','Working Outlook',vNow,'COGS per Unit');

CellIncrementN( COGS_WorkingBudgetFinal  *vQuantity /sMultiplyAUDConstant, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit ,'AUD-Constant','Working Budget',vNow,'Purchase Value');
