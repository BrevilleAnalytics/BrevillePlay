#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Debugging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';
  sTestFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | 'BSStgPurchases.txt';
#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

 ENDIF ;
 
  sServer = 'BrevillePlay' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;


#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General

sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;

sSub_Tgt= '}System.Tgt.' | sUniqueName ;



sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#End Region # Process control

# Process Variables

# General
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  csProcess |'.'| sTimestamp | '.' | sRandomInt;
sSub_Src = '}System.Src.' | sUniqueName ;
sView_Src = '}System.Src.' | sUniqueName ;
sSub_Tgt = '}System.Tgt.' | sUniqueName ;
sView_Tgt = 'TmpBSStgActuals' ;
sLogMessage ='';

# Constants
sSub_Tgt= '}System.Tgt.' | sUniqueName ;
sCub_Tgt = 'VanguardPurchases' ;

#ODBC SQL Statement to update historical CM sales data by month cube CMStgActuals from Azure DataLake
#----------------------------------------------------------------------------------------------------------------------------

DataSourceType = 'ODBC';

# SQL query

 sSQL = 'SET NOCOUNT ON; 
SELECT [Product_3]
      ,[BusinessUnit]
      ,[Month_1]
      ,[Quantity]
      ,[CalendarMonth]
  FROM [stg].[VanguardFinanceForecast]
';
#where[monthYear] = ''' |sCurrentMonth| ''' and [businessUnit] = ''' |pBU| '''

 
		
#DNS_Server = 'brev-dev-syn-fpa';
DNS_Server = CellGetS( 'syEnvironment', 'Breville', 'ODBC DSN for DL'  );

 vNow = Date(Now(),1);
# vNow = '2023-10-12';
DimensionElementInsertDirect ('Checkpoint', '', vNow,'N');
HierarchyElementComponentAdd('Checkpoint','Checkpoint','All Checkpoints', vNow,1);

# Data Source

 DataSourceType = 'ODBC' ;
 DatasourceNameForServer = DNS_Server ;
 DatasourceQuery = sSQL;

# Create temp cubeview
IF( ViewExists( sCub_Tgt , sView_Tgt ) = 1 ) ; 
 ViewDestroy ( sCub_Tgt, sView_Tgt ) ;
ENDIF;
ViewCreate( sCub_Tgt, sView_Tgt , 1 ) ;

# Create temp subsets and assign it to the view

i_TabDim = 1 ;
While ( TabDim ( sCub_Tgt , i_TabDim ) @<> '' ) ;
   sDim = TabDim ( sCub_Tgt , i_TabDim ) ;
  If( sDim @= 'CheckPoint' ) ;
     sMDX = '{ [' | sDim | '].[' | sDim | '].['|vNow|']}';
    Else ;
     sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
  EndIf ;

  
   SubsetCreateByMDX ( sSub_Tgt , sMDX , 1 ) ;
   SubsetMDXSet (sDim , sSub_Tgt , '' ) ;
   ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

i_TabDim = i_TabDim + 1 ;
End ;

#------ View zero out
ViewZeroOut(sCub_Tgt, sView_Tgt);

ASCIIOutput( sTestFile, 'Prolog: ');


#endregion
#region Data

 sMonth = SUBST( vCalendarMonth , 1 , 3 );
# sYear = SUBST ( vCalendarMonth, LONG (vCalendarMonth) -4 +1 , 4);
# sYear = 'FY24';
# sPeriod = 'F' | sYear | '-' | sMonth ;

sPeriod = ATTRS( 'CalendarMonth', vCalendarMonth , 'FiscalMonth' );
#sPeriod = ATTRS( 'CalendarMonth', 'October 2023' , 'FiscalMonth' );
sYear = SUBST ( sPeriod, 1 , 4);

ASCIIOutput( sTestFile, NumbertoString(vQuantity), vProduct , vBusinessUnit  , sPeriod, vCalendarMonth);

#~~~~~~~~~ set validation ~~~~~~~~~~
#~~~ check if element exists
# Customer
sDim = 'Product' ;
sEl = vProduct ;
If (DIMIX( sDim, sEl  ) = 0  ) ;
  sMessage = 'Product = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

# BU
sDim = 'BusinessUnit' ;
sEl = vBusinessUnit ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'BusinessUnit = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
   Itemskip;
Endif;

sDim = 'FiscalMonth' ;
sEl = sPeriod ;
If (DIMIX( sDim, sEl  ) = 0  );
  sMessage = 'FiscalMonth = ' | sEl | ' does not exist' ;
  If(SCAN(sMessage, sLogMessage) =0);
         #ExecuteProcess('syProcessLogMessage','psProcessName',csProcess,'psLogLevel','INFO','psMessage',sMessage ) ;
         sLogMessage = sLogMessage | sMessage;
  Endif;
  Itemskip;
Endif;

 CostOfGoodsSold_WorkingBudget = CellGetn ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Budget' ,
                sPeriod ,'Local' , 'Calculated','Cost of Goods Sold') ;
 CostOfGoodsSold_Budget = CellGetn ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Budget' ,
                sPeriod ,'Local' , 'Calculated','Cost of Goods Sold') ;
 CostOfGoodsSold_WorkingBudgetFY = CellGetn ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Budget' ,
                sYear ,'Local' , 'Calculated','Cost of Goods Sold') ;
 CostOfGoodsSold_BudgetFY = CellGetn ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Budget' ,
                sYear ,'Local' , 'Calculated','Cost of Goods Sold') ;     
 CostOfGoodsSoldOverride_WorkingBudget = CellGetn ( 'VanguardPurchases', vProduct, sPeriod , vBusinessUnit , 'Local' , 'Working Budget' ,'Base','COGS per Unit Override') ;  
 CostOfGoodsSoldOverride_Budget = CellGetn ( 'VanguardPurchases', vProduct, sPeriod , vBusinessUnit , 'Local' , 'Budget' ,'Base','COGS per Unit Override') ;  
              
 Shipped_WorkingBudget = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Budget' ,
                sPeriod ,'Local' , 'Calculated','Net Shipments') ;
 Shipped_Budget = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Budget' ,
                sPeriod ,'Local' , 'Calculated','Net Shipments') ;
 Shipped_WorkingBudgetFY = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Budget' ,
                 sYear,'Local' , 'Calculated','Net Shipments') ;
 Shipped_BudgetFY = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Budget' ,
                 sYear,'Local' , 'Calculated','Net Shipments') ;     
                 
#Calculate COGS per Unit - Working Budget  
 IF(Shipped_WorkingBudget <> 0) ;              
 COGS_WorkingBudget = CostOfGoodsSold_WorkingBudget /  Shipped_WorkingBudget;
 ElseIF(Shipped_WorkingBudgetFY <> 0) ; 
 COGS_WorkingBudget = CostOfGoodsSold_WorkingBudgetFY /  Shipped_WorkingBudgetFY;
 Else;
 COGS_WorkingBudget = 0;
 Endif;

#Save last COGS value or get last saved value
IF(COGS_WorkingBudget >0);
CellPutN( COGS_WorkingBudget , sCub_Tgt ,vProduct , 'No FiscalMonth',vBusinessUnit , 'Local','Working Outlook',vNow,'COGS per Unit');
else;
COGS_WorkingBudget = CellGetN( sCub_Tgt, vProduct , 'No FiscalMonth',vBusinessUnit , 'Local','Working Outlook',vNow,'COGS per Unit');    
Endif;

 #Determine if COGS per Unit Override to be used in calculation - Working Budget
CostOfGoodsSoldOverride_WorkingOutlook = CellGetN ( 'VanguardPurchases', vProduct, sPeriod , vBusinessUnit , 'Local' , 'Working Budget' ,'Base','COGS per Unit Override') ; 

IF( CostOfGoodsSoldOverride_WorkingBudget >0);
 COGS_WorkingBudgetFinal =  CostOfGoodsSoldOverride_WorkingBudget;
 else;
 COGS_WorkingBudgetFinal =  COGS_WorkingBudget;
endif;
 
 #Calculate COGS per Unit -  Budget 
 IF(Shipped_Budget <> 0) ;              
 COGS_Budget = CostOfGoodsSold_Budget /  Shipped_Budget;
 ElseIF(Shipped_BudgetFY <> 0) ; 
 COGS_Budget = CostOfGoodsSold_BudgetFY /  Shipped_BudgetFY;
 Else;
 COGS_Budget = 0;
 Endif;

#Save last COGS value or get last saved value
IF(COGS_Budget >0);
CellPutN( COGS_Budget , sCub_Tgt ,vProduct , 'No FiscalMonth',vBusinessUnit , 'Local','Working Outlook',vNow,'COGS per Unit');
else;
COGS_Budget = CellGetN( sCub_Tgt, vProduct , 'No FiscalMonth',vBusinessUnit , 'Local','Working Outlook',vNow,'COGS per Unit');    
Endif;
 
  #Determine if COGS per Unit Override to be used in calculation - Budget
CostOfGoodsSoldOverride_WorkingOutlook = CellGetN ( 'VanguardPurchases', vProduct, sPeriod , vBusinessUnit , 'Local' , 'Budget' ,'Base','COGS per Unit Override') ; 

IF( CostOfGoodsSoldOverride_Budget >0);
 COGS_BudgetFinal =  CostOfGoodsSoldOverride_Budget;
 else;
 COGS_BudgetFinal =  COGS_Budget;
endif;
 
# COGS_WorkingBudget = CellGetn ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Budget' ,
#                sPeriod ,'Local' , 'Calculated','COGS Unit Cost');
           
               
CostOfGoodsSold_WorkingOutlook = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Outlook' ,
               sPeriod ,'Local' , 'Calculated','Cost of Goods Sold') ;
CostOfGoodsSold_WorkingOutlookFY = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Outlook' ,
               sYear ,'Local' , 'Calculated','Cost of Goods Sold') ;
Shipped_WorkingOutlook = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Outlook' ,
               sPeriod ,'Local' , 'Calculated','Net Shipments') ;
Shipped_WorkingOutlookFY = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Outlook' ,
               sYear ,'Local' , 'Calculated','Net Shipments') ;


#Calculate COGS per Unit - Working Outlook               
IF(Shipped_WorkingOutlook <> 0) ;                  
COGS_WorkingOutlook = CostOfGoodsSold_WorkingOutlook /  Shipped_WorkingOutlook;
Elseif (Shipped_WorkingOutlookFY <> 0);
COGS_WorkingOutlook = CostOfGoodsSold_WorkingOutlookFY /  Shipped_WorkingOutlookFY;
Else;
COGS_WorkingOutlook = 0;
Endif;

#Save last COGS value or get last saved value
IF(COGS_WorkingOutlook >0);
CellPutN( COGS_WorkingOutlook , sCub_Tgt ,vProduct , 'No FiscalMonth',vBusinessUnit , 'Local','Working Outlook',vNow,'COGS per Unit');
else;
COGS_WorkingOutlook = CellGetN( sCub_Tgt, vProduct , 'No FiscalMonth',vBusinessUnit , 'Local','Working Outlook',vNow,'COGS per Unit');    
Endif;

#Determine if COGS per Unit Override to be used in calculation - Working Outlook
CostOfGoodsSoldOverride_WorkingOutlook = CellGetN ( 'VanguardPurchases', vProduct, sPeriod , vBusinessUnit , 'Local' , 'Working Outlook' ,'Base','COGS per Unit Override') ; 

IF(CostOfGoodsSoldOverride_WorkingOutlook >0);
 COGS_WorkingOutlookFinal = CostOfGoodsSoldOverride_WorkingOutlook;
 else;
 COGS_WorkingOutlookFinal = COGS_WorkingOutlook;
endif;


# COGS_WorkingOutlook = CellGetN ( 'CMForecast', vProduct ,'All Segment' , vBusinessUnit , 'All Theatre' , 'Working Outlook' ,
#                sPeriod ,'Local' , 'Calculated','COGS Unit Cost') ;


ASCIIOutput( sTestFile, NumbertoString(vQuantity), NumbertoString(CostOfGoodsSoldOverride_WorkingOutlook),NumbertoString(CostOfGoodsSold_WorkingOutlook), vProduct , vBusinessUnit  , sPeriod);



CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Working Budget',vNow,'Purchased Units');
#CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Budget',vNow,'Purchased Units');
CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Working Outlook',vNow,'Purchased Units');

CellPutN( COGS_WorkingBudget  , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Working Budget',vNow,'COGS per Unit');
#CellPutN( COGS_Budget  , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Budget',vNow,'COGS per Unit');
CellPutN( COGS_WorkingOutlook , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'Local','Working Outlook',vNow,'COGS per Unit');

CellIncrementN( COGS_WorkingBudgetFinal  *vQuantity, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit ,'Local','Working Budget',vNow,'Purchase Value');
#CellIncrementN( COGS_BudgetFinal  *vQuantity, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit ,'Local','Budget',vNow,'Purchase Value');
CellIncrementN( COGS_WorkingOutlookFinal *vQuantity, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit ,'Local','Working Outlook',vNow,'Purchase Value');


sMultiplyAUDBudget = CellGetN (  'BRExchangeRate', vBusinessUnit , sPeriod , 'AUD-Budget' , 'Currency' , 'FXRate') ;
sMultiplyAUDBudget = if (sMultiplyAUDBudget = 0,
  CellGetN (  'BRExchangeRate', vBusinessUnit , SUBST(TODAY(1),1,4)|'0'|SUBST(TODAY(1),6,2) , 'AUD-Budget' , 'Currency' , 'FXRate'),
  sMultiplyAUDBudget
);
sMultiplyAUDConstant = CellGetN (  'BRExchangeRate', vBusinessUnit ,sPeriod , 'AUD-Constant' , 'Currency' , 'FXRate') ;

sMultiplyAUDConstant = if (sMultiplyAUDConstant = 0,
  CellGetN (  'BRExchangeRate', vBusinessUnit , SUBST(TODAY(1),1,4)|'0'|SUBST(TODAY(1),6,2) , 'AUD-Constant' , 'Currency' , 'FXRate'),
  sMultiplyAUDConstant
);

sMultiplyAUDMonthEnd = CellGetN (  'BRExchangeRate', vBusinessUnit ,sPeriod , 'AUD-MonthEnd' , 'Currency' , 'FXRate') ;

sMultiplyAUDMonthEnd = if (sMultiplyAUDMonthEnd = 0,
  CellGetN (  'BRExchangeRate', vBusinessUnit , SUBST(TODAY(1),1,4)|'0'|SUBST(TODAY(1),6,2) , 'AUD-MonthEnd' , 'Currency' , 'FXRate'),
  sMultiplyAUDMonthEnd
);


sMultiplyEURConstant = CellGetN (  'BRExchangeRate', vBusinessUnit ,sPeriod, 'EUR-Constant' , 'Currency' , 'FXRate') ;

sMultiplyEURConstant = if (sMultiplyEURConstant = 0,
  CellGetN (  'BRExchangeRate', vBusinessUnit , SUBST(TODAY(1),1,4)|'0'|SUBST(TODAY(1),6,2) , 'EUR-Constant' , 'Currency' , 'FXRate'),
  sMultiplyEURConstant
);

sMultiplyUSDConstant = CellGetN (  'BRExchangeRate', vBusinessUnit ,sPeriod , 'USD-Constant' , 'Currency' , 'FXRate') ;



sMultiplyUSDConstant = if (sMultiplyUSDConstant = 0,
  CellGetN (  'BRExchangeRate', vBusinessUnit , SUBST(TODAY(1),1,4)|'0'|SUBST(TODAY(1),6,2) , 'USD-Constant' , 'Currency' , 'FXRate'),
  sMultiplyUSDConstant
);


sMultiplyUSDBudget = CellGetN (  'BRExchangeRate', vBusinessUnit ,sPeriod , 'USD-Budget' , 'Currency' , 'FXRate') ;


sMultiplyUSDBudget = if (sMultiplyUSDBudget = 0,
  CellGetN (  'BRExchangeRate', vBusinessUnit , SUBST(TODAY(1),1,4)|'0'|SUBST(TODAY(1),6,2) , 'USD-Budget' , 'Currency' , 'FXRate'),
  sMultiplyUSDBudget
);


sMultiplyAUDOutlook = CellGetN (  'BRExchangeRate', vBusinessUnit ,sPeriod , 'AUD-Outlook' ,'Currency' , 'FXRate') ;

sMultiplyAUDOutlook = if (sMultiplyAUDOutlook = 0,
  CellGetN (  'BRExchangeRate', vBusinessUnit , SUBST(TODAY(1),1,4)|'0'|SUBST(TODAY(1),6,2) , 'AUD-Outlook' , 'Currency' , 'FXRate'),
  sMultiplyAUDOutlook
);


CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Budget','Working Budget',vNow,'Purchased Units');
#CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Budget','Budget',vNow,'Purchased Units');
CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Budget','Working Outlook',vNow,'Purchased Units');

CellPutN( COGS_WorkingBudget / sMultiplyAUDBudget, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Budget','Working Budget',vNow,'COGS per Unit');
#CellPutN( COGS_Budget / sMultiplyAUDBudget, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Budget','Budget',vNow,'COGS per Unit');
CellPutN( COGS_WorkingOutlook / sMultiplyAUDBudget, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Budget','Working Outlook',vNow,'COGS per Unit');

CellIncrementN( COGS_WorkingBudgetFinal  *vQuantity /sMultiplyAUDBudget, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit ,'AUD-Budget','Working Budget',vNow,'Purchase Value');
#CellIncrementN( COGS_BudgetFinal  *vQuantity /sMultiplyAUDBudget, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit ,'AUD-Budget','Budget',vNow,'Purchase Value');
CellIncrementN( COGS_WorkingOutlookFinal *vQuantity / sMultiplyAUDBudget, sCub_Tgt ,vProduct , sPeriod,vBusinessUnit ,'AUD-Budget','Working Outlook',vNow,'Purchase Value');

######################
CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Constant','Working Budget',vNow,'Purchased Units');
#CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Constant','Budget',vNow,'Purchased Units');
CellIncrementN( vQuantity , sCub_Tgt ,vProduct , sPeriod,vBusinessUnit , 'AUD-Constant','Working Outlook',vNow,'Purchased Units');

