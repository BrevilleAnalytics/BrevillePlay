# Debug Flie Reference
  sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';
  sTestFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | 'EBITRegionalMarketing.txt';

pVersion = DimensionElementPrincipalName( 'Version', pVersion ) ;

#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~System Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
 IF ( psTITracker @= '' ) ;
  psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

 ENDIF ;
 
  sServer = 'Breville' ;
  sUser = TM1User();
  nStartTime = NOW;
  sSystemMessage = '';
  nRecordCountData = 0;
  nRecordCountMetadata = 0;
  NumericGlobalVariable( 'PrologMinorErrorCount' );
  NumericGlobalVariable( 'MetaDataMinorErrorCount' );
  NumericGlobalVariable( 'DataMinorErrorCount' );
  nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
	sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
	sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
	sUserName = 'Unknown';
ENDIF;


#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
   csProcessReference = psProcessReference ;
Else ; 
   csProcessReference = csProcess ;
   ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
	ExecuteProcess('syTITracker',
	  'pProcessName', GetProcessName,
	  'pTime', nStartTime ,
	  'pStatus', 1,
	  'pTM1User', sUserName,
	  'pSystemMessage', sSystemMessage,
	  'pRecordCount', nRecordCountData + nRecordCountMetadata,
	  'pPrologMinorErrorCount', PrologMinorErrorCount,
	  'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
	  'pDataMinorErrorCount', DataMinorErrorCount,
	  'pDebug', 1 );
ENDIF;



#End Region # Logging
#------------------------------------------------------------------------------------------



#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Process Constants and Variables ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Region: General


sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;

sSub_Tgt= '}System.Tgt.' | sUniqueName ;



sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#End Region # Process control



# Process Variables

# General
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  csProcess |'.'| sTimestamp | '.' | sRandomInt;

# Process Variables

# General
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  csProcess |'.'| sTimestamp | '.' | sRandomInt;

#-- Set the period range to update 
#-- the period range 
sFiscalMonth_Start_C = DimensionElementPrincipalName( 'FiscalMonth', CellGetS( 'BRAsVersion', 'NoVersion', 'APAC Outlook Month')) ;
nPeriodIndex_Start_C = StringToNumber(ATTRS('FiscalMonth', sFiscalMonth_Start_C, 'PeriodIndex')) ;
nPeriodIndex_Start = nPeriodIndex_Start_C - 1 ;
sFiscalMonth_Start = DimensionElementPrincipalName( 'FiscalMonth', FILL( '0', 10 - LONG(NumberToString(nPeriodIndex_Start))) | NumberToString(nPeriodIndex_Start)) ;

nOutlookPeriods = CellGetN( 'BRAsVersion', 'NoVersion', 'NumofMonths' ) ;
nPeriodIndex_End = nPeriodIndex_Start + nOutlookPeriods ;
sFiscalMonth_End = DimensionElementPrincipalName( 'FiscalMonth', FILL( '0', 10 - LONG(NumberToString(nPeriodIndex_End))) | NumberToString(nPeriodIndex_End)) ;
#-- Create a ranged subset
sSub_Period_All = '}System.Tgt.AllELements' | sUniqueName ;

sMDX = '{TM1FILTERBYLEVEL( {DISTINCT({DESCENDANTS([FiscalMonth].[FiscalMonth].[All FY])})}, 0)}';      
SubsetCreateByMDX( sSub_Period_All, sMDX, 1 ) ;

nsSub_Period_All_Size = SubsetGetSize( 'FiscalMonth', sSub_Period_All );


nPeriodIndex_Start = StringToNumber(ATTRS('FiscalMonth', sFiscalMonth_Start, 'PeriodIndex'));
nPeriodIndex_End = StringToNumber(ATTRS('FiscalMonth', sFiscalMonth_End, 'PeriodIndex'));

sBudgetYear = DimensionElementPrincipalName( 'FiscalMonth', CellGetS( 'BRAsVersion', 'NoVersion', 'Budget Year')) ;

# Create temp subsets and assign it to the view
sCube = 'PnLPlan' ;
sSub = 'TempCorporateMktgPnLPlanOutlook' ;
sView = sSub ;
pTemp = 1 ; 

# Create Target View
If ( ViewExists ( sCube , sView ) <> 0 ) ;
   ViewDestroy ( sCube , sView ) ;
EndIf ;
ViewCreate ( sCube , sView , pTemp ) ;

sDim = 'GLAccount' ;
sMDX = '{FILTER(TM1FILTERBYLEVEL(TM1SUBSETALL([GLAccount].[GLAccount]) , 0) , (INSTR(1 , [GLAccount].[GLAccount].CURRENTMEMBER.PROPERTIES("ExpenseClassify") , "Marketing Corporate" , 1) >= 1)),
FILTER(TM1FILTERBYLEVEL(TM1SUBSETALL([GLAccount].[GLAccount]) , 0) , (INSTR(1 , [GLAccount].[GLAccount].CURRENTMEMBER.PROPERTIES("ExpenseClassify") , "Marketing Specialty" , 1) >= 1))}' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;


sDim = 'CostCentre' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'BusinessUnit' ;
if( pBU @<> '' & pBU @<> 'All Business Unit' ) ;
sMDX = '{ [' | sDim | '].[' | sDim | '].[' | pBU | '] }' ;
else ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
endif;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp  ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'Segment' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'OPXComponent' ;
sEle = 'OPEX' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDeleteAllElements ( sDim , sSub ) ;
Else ;
   SubsetCreate ( sDim , sSub  ) ;
EndIf ;
SubsetElementInsert ( sDim , sSub , sEle , 1 ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'Currency' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'FiscalMonth' ;
sDim = 'FiscalMonth' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDeleteAllElements ( sDim , sSub ) ;
Else ;
   SubsetCreate ( sDim , sSub ) ;
EndIf ;
if ( pVersion @= 'Outlook' ) ;
While (nsSub_Period_All_Size >= 1);
#get element name 
	sPeriod_Current = SubsetGetElementName( 'FiscalMonth', sSub_Period_All, nsSub_Period_All_Size);
	sPeriodIndex_Current = ATTRS('FiscalMonth', sPeriod_Current, 'PeriodIndex');
    nPeriodIndex_Current = StringToNumber(sPeriodIndex_Current);

	If(nPeriodIndex_Start <= nPeriodIndex_Current & nPeriodIndex_End >= nPeriodIndex_Current);  
    	i=1;
        SubsetElementInsert( sDim ,  sSub , sPeriod_Current,i);
        # ASCIIOutput( sTestFile, NumberToString (nPeriodIndex_End) , sFiscalMonth_End , NumberToString (nPeriodIndex_Start ) , sFiscalMonth_Start , sPeriod_Current , NumberToString ( nPeriodIndex_Current ) ) ;
        i=i+1;
	Endif;

	nsSub_Period_All_Size = nsSub_Period_All_Size - 1;
End;
endif ;
if ( pVersion @= 'Working Budget' ) ;
sMDX = '{TM1FILTERBYLEVEL( {DISTINCT({DESCENDANTS([FiscalMonth].[FiscalMonth].[' | sBudgetYear | '])})}, 0)}';     
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
endif ;
if ( pVersion @= 'Budget' % pVersion @= 'FCST 3+9' ) ;
sMDX = '{TM1FILTERBYLEVEL( {DISTINCT({DESCENDANTS([FiscalMonth].[FiscalMonth].[All FY])})}, 0)}';     
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
endif ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'Version' ;
sEle = pVersion ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDeleteAllElements ( sDim , sSub ) ;
Else ;
   SubsetCreate ( sDim , sSub  ) ;
EndIf ;
SubsetElementInsert ( sDim , sSub , sEle , 1 ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'GlobalTheatre' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDestroy ( sDim , sSub ) ;
EndIf ;
SubsetCreatebyMDX ( sSub , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub , '' ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;

sDim = 'PnLPlanMeasure' ;
sEle = 'Amount' ;
If ( SubsetExists ( sDim , sSub ) = 1 ) ;
   SubsetDeleteAllElements ( sDim , sSub ) ;
Else ;
   SubsetCreate ( sDim , sSub  ) ;
EndIf ;
SubsetElementInsert ( sDim , sSub , sEle , 1 ) ;
ViewSubsetAssign ( sCube , sView , sDim , sSub ) ;


ViewExtractSkipCalcsSet ( sCube , sView , 1 ) ;
ViewExtractSkipRuleValuesSet ( sCube , sView , 1 ) ;
ViewExtractSkipZeroesSet ( sCube , sView , 1 ) ;


# Assign Datasource
DataSourceType = 'VIEW' ;
DataSourceNameForServer = sCube ;
DataSourceCubeview = sView ;

nsSub_Period_All_Size = SubsetGetSize( 'FiscalMonth', sSub_Period_All );

# Create temp subsets and assign it to the view
sCub_Tgt = 'GlobalEBIT' ;
sSub_Tgt = 'TempPnLCorporateMktgDataOutlook' ;
sView_Tgt = sSub_Tgt ;
pTemp = 1 ; 

# Create Target View
If ( ViewExists ( sCub_Tgt , sView_Tgt ) <> 0 ) ;
   ViewDestroy ( sCub_Tgt , sView_Tgt ) ;
EndIf ;
ViewCreate ( sCub_Tgt , sView_Tgt , pTemp ) ;

sDim = 'EBITAccount' ;
sMDX = '{ ['|sDim|'].['|sDim|'].[Marketing Corporate ATL],
['|sDim|'].['|sDim|'].[Marketing Corporate BTL],
['|sDim|'].['|sDim|'].[Marketing Corporate Committed],
['|sDim|'].['|sDim|'].[Marketing Corporate Specialty],
['|sDim|'].['|sDim|'].[Marketing Corporate Uncommitted],
['|sDim|'].['|sDim|'].[Marketing Specialty ATL],
['|sDim|'].['|sDim|'].[Marketing Specialty BTL] }' ;
If ( SubsetExists ( sDim , sSub_Tgt ) = 1 ) ;
   SubsetDestroy ( sDim , sSub_Tgt ) ;
EndIf ;
SubsetCreatebyMDX ( sSub_Tgt , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub_Tgt , '' ) ;
ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

sDim = 'BusinessUnit' ;
if( pBU @<> '' & pBU @<> 'All Business Unit' ) ;
sMDX = '{ [' | sDim | '].[' | sDim | '].[' | pBU | '] }' ;
else ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
endif;
If ( SubsetExists ( sDim , sSub_Tgt ) = 1 ) ;
   SubsetDestroy ( sDim , sSub_Tgt ) ;
EndIf ;
SubsetCreatebyMDX ( sSub_Tgt , sMDX , pTemp  ) ;
SubsetMDXSet ( sDim , sSub_Tgt , '' ) ;
ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

sDim = 'Segment' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub_Tgt ) = 1 ) ;
   SubsetDestroy ( sDim , sSub_Tgt ) ;
EndIf ;
SubsetCreatebyMDX ( sSub_Tgt , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub_Tgt , '' ) ;
ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

sDim = 'Currency' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub_Tgt ) = 1 ) ;
   SubsetDestroy ( sDim , sSub_Tgt ) ;
EndIf ;
SubsetCreatebyMDX ( sSub_Tgt , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub_Tgt , '' ) ;
ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

sDim = 'FiscalMonth' ;
If ( SubsetExists ( sDim , sSub_Tgt ) = 1 ) ;
   SubsetDeleteAllElements ( sDim , sSub_Tgt ) ;
Else ;
   SubsetCreate ( sDim , sSub_Tgt ) ;
EndIf ;
if ( pVersion @= 'Outlook' ) ;
While (nsSub_Period_All_Size >= 1);
#get element name 
	sPeriod_Current = SubsetGetElementName( 'FiscalMonth', sSub_Period_All, nsSub_Period_All_Size);
	sPeriodIndex_Current = ATTRS('FiscalMonth', sPeriod_Current, 'PeriodIndex');
    nPeriodIndex_Current = StringToNumber(sPeriodIndex_Current);

	If(nPeriodIndex_Start <= nPeriodIndex_Current & nPeriodIndex_End >= nPeriodIndex_Current);  
    	i=1;
        SubsetElementInsert( sDim ,  sSub_Tgt , sPeriod_Current,i);
        # ASCIIOutput( sTestFile, NumberToString (nPeriodIndex_End) , sFiscalMonth_End , NumberToString (nPeriodIndex_Start ) , sFiscalMonth_Start , sPeriod_Current , NumberToString ( nPeriodIndex_Current ) ) ;
        i=i+1;
	Endif;

	nsSub_Period_All_Size = nsSub_Period_All_Size - 1;
End;
endif ;
if ( pVersion @= 'Working Budget' ) ;
sMDX = '{TM1FILTERBYLEVEL( {DISTINCT({DESCENDANTS([FiscalMonth].[FiscalMonth].[' | sBudgetYear | '])})}, 0)}';     
SubsetCreatebyMDX ( sSub_Tgt , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub_Tgt , '' ) ;
endif ;
if ( pVersion @= 'Budget' % pVersion @= 'FCST 3+9' ) ;
sMDX = '{TM1FILTERBYLEVEL( {DISTINCT({DESCENDANTS([FiscalMonth].[FiscalMonth].[All FY])})}, 0)}';     
SubsetCreatebyMDX ( sSub_Tgt , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub_Tgt , '' ) ;
endif ;
ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

sDim = 'Version' ;
sEle = pVersion ;
If ( SubsetExists ( sDim , sSub_Tgt ) = 1 ) ;
   SubsetDeleteAllElements ( sDim , sSub_Tgt ) ;
Else ;
   SubsetCreate ( sDim , sSub_Tgt  ) ;
EndIf ;
SubsetElementInsert ( sDim , sSub_Tgt , sEle , 1 ) ;
ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

sDim = 'GlobalTheatre' ;
sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
If ( SubsetExists ( sDim , sSub_Tgt ) = 1 ) ;
   SubsetDestroy ( sDim , sSub_Tgt ) ;
EndIf ;
SubsetCreatebyMDX ( sSub_Tgt , sMDX , pTemp ) ;
SubsetMDXSet ( sDim , sSub_Tgt , '' ) ;
ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;

sDim = 'GlobalEBITMeasure' ;
sEle = 'Amount' ;
If ( SubsetExists ( sDim , sSub_Tgt ) = 1 ) ;
   SubsetDeleteAllElements ( sDim , sSub_Tgt ) ;
Else ;
   SubsetCreate ( sDim , sSub_Tgt  ) ;
EndIf ;
SubsetElementInsert ( sDim , sSub_Tgt , sEle , 1 ) ;
ViewSubsetAssign ( sCub_Tgt , sView_Tgt , sDim , sSub_Tgt ) ;



#------ View zero out
 ViewZeroOut(sCub_Tgt, sView_Tgt);



#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

##Counter

nRecordCountData = nRecordCountData  + 1 ;

## Update Values
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

sGL = ATTRS( 'GLAccount', vGLAccount , 'ExpenseClassify' ) ;

# ASCIIOutput( sTestFile, vGLAccount , vBusinessUnit , vSegment , vCurrency , vFiscalMonth , 'Actual' , vGlobalTheatre , 'Amount' );

CellIncrementN ( vnValue , 'GlobalEBIT' , sGL , vBusinessUnit , vSegment , vCurrency , vFiscalMonth , pVersion , vGlobalTheatre , 'Amount'  ) ;

 
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****


            
#----------------------------------------------------------------------------------------------------------------------------
# ~~~~~~~~~~Logging ~~~~~~~~~~~~~~~#
#----------------------------------------------------------------------------------------------------------------------------
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
  sLogLevel = 'ERROR';
  sLogReference = GetProcessErrorFilename();
  sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
  sLogLevel = 'INFO';
  sLogReference = '';
  sMessage = 'Process completed successfully. Total records: ' | NumberToString (nRecordCountMetadata  )   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
 # Check for minor errors
 IF ( sSystemMessage @= '' );
   IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
     sSystemMessage = 'Successful';
   ELSE;
     IF ( DataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
     ENDIF;
     IF ( PrologMinorErrorCount <> 0 );
       sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
     ENDIF;
     IF ( MetaDataMinorErrorCount <> 0 );
       sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
     ENDIF;
         sSystemMessage= sSystemMessage ;
    ENDIF;
 ENDIF;

if ( pBU @= '' ) ;
sBU = 'All BUs';
else ;
sBU = pBU ;
endif ;

  ExecuteProcess('syTITracker',
   'pProcessName', GetProcessName,
   'pParameter01' , 'Version: ' | 'Actual' ,
   'pParameter02' , 'BU: ' | sBU ,
   'pTime', nStartTime ,
   'pStatus', 0,
   'pTM1User', sUserName,
   'pSystemMessage', sSystemMessage,
   'pRecordCount', nRecordCountData + nRecordCountMetadata,
   'pPrologMinorErrorCount', PrologMinorErrorCount,
   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
   'pDataMinorErrorCount', DataMinorErrorCount,
   'pDebug', 1 );
ENDIF;
#End Region # TI Tracker
#endregion