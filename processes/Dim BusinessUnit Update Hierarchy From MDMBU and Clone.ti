#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****

#Region # Process Summary

#<Process Description>
# This process creates the Region Hierarchy in BusinessUnit Dimension using MDMBU cube

#<Changes Log>
# V1 - 29/07/2022 - Jithu Varghese - CPM Group - First draft
# V2 - 02/08/2022 - Jithu Varghese - CPM Group - Refined Hierarchy build logic
# V3 - 12/10/2022 - Jithu Varghese - CPM Group - Created new attribute CMBU to update Business Units relevant to ONLY CM
# V3 - 03/11/2022 - Jithu Varghese - CPM Group - Updated main hierarchy to include Regions hierarchy
#<Maintenance Log\>


#<Execute Method>
# Daily Schedule
#<Execute Method\>

#<Processes Executed>
# syProcessLogInitialise
# syProcessLogMessage
# syTITracker
#<Processes Executed\>

#<Execute Schedule>
# Scheduled daily
#<Execute Schedule\>

#<Estimated Run Time>
# ~3 secs
#<Estimated Run Time\>

#EndRegion

#Region ~~~~~~~~~~Debugging
# Debug Flie Reference
sDebugFile = CellGetS( 'syEnvironment', 'Breville', 'Temp Folder') | '\' | GetProcessName() | '.txt';
#EndRegion

#Region ~~~~~~~~~~System Variables
IF ( psTITracker @= '' ) ;
    psTITracker =  CellGetS ( 'syEnvironment', 'Breville', 'psyProcessLog' ) ;

ENDIF ;

sServer = 'Breville Play' ;
sUser = TM1User();
nStartTime = NOW;
sSystemMessage = '';
nRecordCountData = 0;
nRecordCountMetadata = 0;
NumericGlobalVariable( 'PrologMinorErrorCount' );
NumericGlobalVariable( 'MetaDataMinorErrorCount' );
NumericGlobalVariable( 'DataMinorErrorCount' );
nErrors = 0 ;

IF ( DIMIX ( '}Clients', sUser ) > 0 );
    sUserName = NUMBERTOSTRING ( DIMIX ( '}Clients', sUser ) );
ELSEIF ( DIMIX ( '}Chores', TRIM ( SUBST ( sUser, 3, 255 ) ) ) > 0 );
    sUserName= TRIM ( SUBST ( sUser, 3, 255 ) );
ELSE;
    sUserName = 'Unknown';
ENDIF;
#EndRegion

#Region ~~~~~~~~~~Logging

## Process Logging - 1
csProcess = GetProcessName( ) ;
If( psProcessReference @<> '' ) ;
    csProcessReference = psProcessReference ;
Else ; 
    csProcessReference = csProcess ;
    ExecuteProcess('syProcessLogInitialise' , 'psProcessName' , csProcessReference);
EndIf ;
ExecuteProcess('syProcessLogMessage' , 'psProcessName' , csProcessReference , 'psLogLevel' , 'INFO' , 'psMessage' , 'Starting Process ' | csProcess  ) ;

## TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
    ExecuteProcess('syTITracker',
                   'pProcessName', GetProcessName,
                   'pTime', nStartTime ,
                   'pStatus', 1,
                   'pTM1User', sUserName,
                   'pSystemMessage', sSystemMessage,
                   'pRecordCount', nRecordCountData + nRecordCountMetadata,
                   'pPrologMinorErrorCount', PrologMinorErrorCount,
                   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
                   'pDataMinorErrorCount', DataMinorErrorCount,
                   'pDebug', 1 );
ENDIF;

#EndRegion

#Region ~~~~~~~~~~Process Constants and Variables
# Region: General


sProcess = GetProcessName();
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  sProcess |'.'| sTimestamp | '.' | sRandomInt;

sSub_Tgt= '}System.Tgt.' | sUniqueName ;



sMonth = TIMST ( nStartTime, '\m' );
sDay = TIMST ( nStartTime, '\d' );
sHour = TIMST ( nStartTime, '\h' );


#EndRegion

#Region~~~~~~~~~ Build dimensions

# constant
sDimName_Tgt = 'BusinessUnit';
sDimClone1 = 'From Business Unit';
sDimClone2 = 'To Business Unit';
sHierName_Tgt = 'Region';
sHierName_Main = sDimName_Tgt ;

If(DimensionExists( sDimName_Tgt  ) = 0 ) ;
    DimensionCreate( sDimName_Tgt  ) ;
Endif;

        IF( DimensionExists( sDimClone1 ) = 0 );
            DimensionCreate( sDimClone1 );
        ENDIF ;
        
        IF( DimensionExists( sDimClone2 ) = 0 );
            DimensionCreate( sDimClone2 );    
        ENDIF;

#-- Create a target dimension hieararchy
If(HierarchyExists(sDimName_Tgt, sHierName_Tgt) = 0);
    HierarchyCreate(sDimName_Tgt, sHierName_Tgt);
Else;
    HierarchyDeleteAllElements(sDimName_Tgt, sHierName_Tgt);
Endif;

# Create Top Hierarchy
sElTopParent = 'All ' | sHierName_Tgt  ;
HierarchyElementInsert ( sDimName_Tgt, sHierName_Tgt, '',sElTopParent, 'C');
HierarchyElementInsert ( sDimName_Tgt, sHierName_Main, '',sElTopParent, 'C');
HierarchySortOrder( sDimName_Tgt,  sHierName_Tgt,  'ByName', 'Ascending','ByHierarchy', 'Ascending'); 

#Create Top Hierarchy Clone dimensions
DimensionElementInsert ( sDimClone1,'',sElTopParent, 'C');
DimensionElementInsert ( sDimClone2,'',sElTopParent, 'C');

# ~~~~~~~~~~ Create attribtues ~~~~~~~~~~~~~~~~~~~~
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'Caption', 'S');
ElementAttrInsert(sDimName_Tgt, sHierName_Tgt, '', 'CodeCaption', 'A');

        AttrInsert(sDimClone1, '', 'Caption', 'S');
        AttrInsert(sDimClone1, '', 'CodeCaption', 'A');
        
        AttrInsert(sDimClone2, '', 'Caption', 'S');
        AttrInsert(sDimClone2, '', 'CodeCaption', 'A');

#Region Process Variables

# General
sTimestamp = TimSt( Now, '\Y\m\d\h\i\s' );
sRandomInt = NumberToString( INT( RAND( ) * 1000 ));
sUniqueName  =  csProcess |'.'| sTimestamp | '.' | sRandomInt;
sSub_Src = '}System.Src.' | sUniqueName ;
sView_Src = '}System.Src.' | sUniqueName ;
sSub_Tgt = '}System.Tgt.' | sUniqueName ;
sView_Tgt = '}System.Tgt.' | sUniqueName ;

# Constants
sSub_Tgt= '}System.Tgt.' | sUniqueName ;
sCub_Src = 'MDMBU' ;

# Create temp cubeview
IF( ViewExists( sCub_Src , sView_Src) = 1 ) ; 
    ViewDestroy ( sCub_Src, sView_Src ) ;
ENDIF;
ViewCreate( sCub_Src, sView_Src, 1 ) ;
#EndRegion

#Region Create temp subsets and assign it to the view

i_TabDim = 1 ;
While ( TabDim ( sCub_Src , i_TabDim ) @<> '' ) ;
    sDim = TabDim ( sCub_Src , i_TabDim ) ;

    If( sDim @= 'BusinessUnit' ) ;
        sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
    ElseIf( sDim @= 'MDMBUMeasure' ) ;
        sMDX = '{ [' | sDim | '].[' | sDim | '].[Parent Level 1] }' ;
    Else ;
        sMDX = '{TM1FILTERBYLEVEL ( {TM1SUBSETALL ( ['|sDim|'] ) } , 0 ) }' ;
    EndIf ;

    SubsetCreateByMDX ( sSub_Src , sMDX , 1 ) ;
    SubsetMDXSet (sDim , sSub_Src , '' ) ;
    ViewSubsetAssign ( sCub_Src , sView_Src , sDim , sSub_Src ) ;

    i_TabDim = i_TabDim + 1 ;
End ;

ViewExtractSkipZeroesSet( sCub_Src, sView_Src, 0 ) ;
ViewExtractSkipCalcsSet( sCub_Src, sView_Src, 1) ;
ViewExtractSkipRuleValuesSet( sCub_Src, sView_Src, 0) ;
#EndRegion

# Assign Datasource
DataSourceType = 'VIEW' ;
DataSourceNameForServer = sCub_Src ;
DataSourceCubeview = sView_Src ;
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

sElName = vBU ;
sElParent4 = CellGetS(sCub_Src, vBU, 'Parent Level 4' )  ;
sElParent3 = CellGetS(sCub_Src, vBU, 'Parent Level 3' )  ;
sElParent2 = CellGetS(sCub_Src, vBU, 'Parent Level 2' )  ;
sElParent1 = CellGetS(sCub_Src, vBU, 'Parent Level 1' )  ;

#--Add leaf element
HierarchyElementInsert ( sDimName_Tgt, sHierName_Tgt, '', vBU , 'N');

        DimensionElementInsert ( sDimClone1 , '' , sElName , 'N' ) ;
        DimensionElementInsert ( sDimClone2 , '' , sElName , 'N' ) ;

#--Add c levels  element

if ( sElParent4 @<> '' & ElementIndex ( sDimName_Tgt, sHierName_Tgt , sElParent4) = 0  ) ;
    HierarchyElementInsert ( sDimName_Tgt, sHierName_Tgt, '', sElParent4, 'C');
    HierarchyElementInsert ( sDimName_Tgt, sHierName_Main, '', sElParent4, 'C');
endif ;

if ( sElParent3 @<> '' & ElementIndex ( sDimName_Tgt, sHierName_Tgt , sElParent3) = 0  ) ;
    HierarchyElementInsert ( sDimName_Tgt, sHierName_Tgt, '', sElParent3, 'C');
    HierarchyElementInsert ( sDimName_Tgt, sHierName_Main, '', sElParent3, 'C');

endif;
if ( sElParent2 @<> '' & ElementIndex ( sDimName_Tgt , sHierName_Tgt , sElParent2 ) = 0  ) ;
    HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '', sElParent2 , 'C' );
    HierarchyElementInsert ( sDimName_Tgt , sHierName_Main , '', sElParent2 , 'C' );

endif;
if ( sElParent1 @<> '' & ElementIndex ( sDimName_Tgt , sHierName_Tgt , sElParent1) = 0  ) ;
    HierarchyElementInsert ( sDimName_Tgt , sHierName_Tgt , '', sElParent1, 'C');
    HierarchyElementInsert ( sDimName_Tgt , sHierName_Main , '', sElParent1, 'C');

endif;

        # From Business Unit
        IF ( sElParent4 @<> '' & DIMIX ( sDimClone1,  sElParent4) = 0  ) ;
            DimensionElementInsert ( sDimClone1,  '', sElParent4, 'C');
        ENDIF ;
        
        IF ( sElParent3 @<> '' & DIMIX ( sDimClone1,  sElParent3) = 0  ) ;
            DimensionElementInsert ( sDimClone1,  '', sElParent3, 'C');
        ENDIF;
        IF ( sElParent2 @<> '' & DIMIX ( sDimClone1 ,  sElParent2 ) = 0  ) ;
            DimensionElementInsert ( sDimClone1 ,  '', sElParent2 , 'C' );
        ENDIF;
        IF ( sElParent1 @<> '' & DIMIX ( sDimClone1 ,  sElParent1) = 0  ) ;
            DimensionElementInsert ( sDimClone1 ,  '', sElParent1, 'C');
        ENDIF;

        # To Business Unit
        IF ( sElParent4 @<> '' & DIMIX ( sDimClone2,  sElParent4) = 0  ) ;
            DimensionElementInsert ( sDimClone2,  '', sElParent4, 'C');
        ENDIF ;
        
        IF ( sElParent3 @<> '' & DIMIX ( sDimClone2,  sElParent3) = 0  ) ;
            DimensionElementInsert ( sDimClone2,  '', sElParent3, 'C');
        ENDIF;
        IF ( sElParent2 @<> '' & DIMIX ( sDimClone2 ,  sElParent2 ) = 0  ) ;
            DimensionElementInsert ( sDimClone2 ,  '', sElParent2 , 'C' );
        ENDIF;
        IF ( sElParent1 @<> '' & DIMIX ( sDimClone2 ,  sElParent1) = 0  ) ;
            DimensionElementInsert ( sDimClone2 ,  '', sElParent1, 'C');
        ENDIF;

#--Add c levels  hierarchy

if ( sElParent1 @<> '' ) ;
    #-- Add a hierarchy dependency: based on the assumption is that every element wil have a level 1
    HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Tgt , sElParent1, vBU , 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt , sHierName_Main , sElParent1, vBU , 1 );

elseif ( sElParent2 @<> '' ) ;

    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElParent2, sElParent1, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main , sElParent2, sElParent1, 1 );


elseif ( sElParent3 @<> '' ) ;

    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElParent3, sElParent2, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main , sElParent3, sElParent2, 1 );


elseif ( sElParent4 @<> '' ) ;

    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElParent4, sElParent3, 1 );  
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main , sElParent4, sElParent3, 1 ); 

endif ;

        #From Business Unit
        IF ( sElParent1 @<> '' ) ;
            DimensionElementComponentAdd ( sDimClone1 , sElParent1, vBU , 1 );
        
        ELSEIF ( sElParent2 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone1, sElParent2, sElParent1, 1 );
        
        ELSEIF ( sElParent3 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone1, sElParent3, sElParent2, 1 );
        
        ELSEIF ( sElParent4 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone1, sElParent4, sElParent3, 1 );  
        
        ENDIF ;

        #To Business Unit
        IF ( sElParent1 @<> '' ) ;
            DimensionElementComponentAdd ( sDimClone2 , sElParent1, vBU , 1 );
        
        ELSEIF ( sElParent2 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone2, sElParent2, sElParent1, 1 );
        
        ELSEIF ( sElParent3 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone2, sElParent3, sElParent2, 1 );
        
        ELSEIF ( sElParent4 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone2, sElParent4, sElParent3, 1 );  
        
        ENDIF ;

# To ensure all the parents are attached correctly to their children 

if ( sElParent4 @<> '' & sElParent3 @<> '' & sElParent2 @<> '' & sElParent1 @<> '' ) ;

    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElTopParent, sElParent4, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElParent4, sElParent3, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElParent3, sElParent2, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElParent2, sElParent1, 1 );

    # Alternative hierarchy in BusinessUnit Main hierarchy

    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main, sElTopParent, sElParent4, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main, sElParent4, sElParent3, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main, sElParent3, sElParent2, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main, sElParent2, sElParent1, 1 );               


endif ;

if ( sElParent4 @= '' & sElParent3 @<> '' & sElParent2 @<> '' & sElParent1 @<> '' ) ;

    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElTopParent, sElParent3, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElParent3, sElParent2, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElParent2, sElParent1, 1 );

    # Alternative hierarchy in BusinessUnit Main hierarchy

    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main, sElTopParent, sElParent3, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main, sElParent3, sElParent2, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main, sElParent2, sElParent1, 1 );               

endif ;

if ( sElParent4 @= '' & sElParent3 @= '' & sElParent2 @<> '' & sElParent1 @<> '' ) ;

    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElTopParent, sElParent2, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Tgt , sElParent2, sElParent1, 1 );

    # Alternative hierarchy in BusinessUnit Main hierarchy

    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main, sElTopParent, sElParent2, 1 );
    HierarchyElementComponentAdd ( sDimName_Tgt, sHierName_Main, sElParent2, sElParent1, 1 );               

endif ; 

        #From Business Unit
        IF ( sElParent4 @<> '' & sElParent3 @<> '' & sElParent2 @<> '' & sElParent1 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone1,  sElTopParent, sElParent4, 1 );
            DimensionElementComponentAdd ( sDimClone1,  sElParent4, sElParent3, 1 );
            DimensionElementComponentAdd ( sDimClone1,  sElParent3, sElParent2, 1 );
            DimensionElementComponentAdd ( sDimClone1,  sElParent2, sElParent1, 1 );
        
        ENDIF ;
        
        IF ( sElParent4 @= '' & sElParent3 @<> '' & sElParent2 @<> '' & sElParent1 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone1,  sElTopParent, sElParent3, 1 );
            DimensionElementComponentAdd ( sDimClone1,  sElParent3, sElParent2, 1 );
            DimensionElementComponentAdd ( sDimClone1,  sElParent2, sElParent1, 1 );
        
        ENDIF ;
        
        IF ( sElParent4 @= '' & sElParent3 @= '' & sElParent2 @<> '' & sElParent1 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone1,  sElTopParent, sElParent2, 1 );
            DimensionElementComponentAdd ( sDimClone1,  sElParent2, sElParent1, 1 );
         
        ENDIF ;           

        #To Business Unit
        IF ( sElParent4 @<> '' & sElParent3 @<> '' & sElParent2 @<> '' & sElParent1 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone2,  sElTopParent, sElParent4, 1 );
            DimensionElementComponentAdd ( sDimClone2,  sElParent4, sElParent3, 1 );
            DimensionElementComponentAdd ( sDimClone2,  sElParent3, sElParent2, 1 );
            DimensionElementComponentAdd ( sDimClone2,  sElParent2, sElParent1, 1 );
        
        ENDIF ;
        
        IF ( sElParent4 @= '' & sElParent3 @<> '' & sElParent2 @<> '' & sElParent1 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone2,  sElTopParent, sElParent3, 1 );
            DimensionElementComponentAdd ( sDimClone2,  sElParent3, sElParent2, 1 );
            DimensionElementComponentAdd ( sDimClone2,  sElParent2, sElParent1, 1 );
        
        ENDIF ;
        
        IF ( sElParent4 @= '' & sElParent3 @= '' & sElParent2 @<> '' & sElParent1 @<> '' ) ;
        
            DimensionElementComponentAdd ( sDimClone2,  sElTopParent, sElParent2, 1 );
            DimensionElementComponentAdd ( sDimClone2,  sElParent2, sElParent1, 1 );
         
        ENDIF ;           

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

sCMBU = CellGetS(sCub_Src, vBU, 'CMBU' )  ;

# Update CMBU Attribute to filter out CM Business Units in Subsets
AttrPutS( sCMBU, sDimName_Tgt , vBU , 'CMBU' );

# Add Attributes
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

#Region ~~~~~~~~~~Logging
# Finish Process log 1
nErrors = MetaDataMinorErrorCount + DataMinorErrorCount ;
If( GetProcessErrorFilename() @<> '' % nErrors > 0 );
    sLogLevel = 'ERROR';
    sLogReference = GetProcessErrorFilename();
    sMessage = 'Process completed with ' | NumberToString( nErrors ) | ' minor errors';
Else;
    sLogLevel = 'INFO';
    sLogReference = '';
    sMessage = 'Process completed successfully. Total records: ' | NumberToString (nRecordCountMetadata  )   ;
EndIf;

#logoutput( 'INFO', sMessage );
ExecuteProcess('syProcessLogMessage', 'psProcessName', csProcessReference , 'psLogLevel', sLogLevel, 'psMessage', sMessage , 'psProcessErrorReference' , sLogReference );

## Finish TI Tracker Process Logging - 2
IF( psTITracker @= 'Y' );
    # Check for minor errors
    IF ( sSystemMessage @= '' );
        IF ( DataMinorErrorCount = 0 & PrologMinorErrorCount = 0 & MetaDataMinorErrorCount = 0 );
            sSystemMessage = 'Successful';
        ELSE;
            IF ( DataMinorErrorCount <> 0 );
                sSystemMessage = NumberToString ( DataMinorErrorCount ) | ' data error/s; ';
            ENDIF;
            IF ( PrologMinorErrorCount <> 0 );
                sSystemMessage =NumberToString ( PrologMinorErrorCount ) | ' prolog error/s; ';
            ENDIF;
            IF ( MetaDataMinorErrorCount <> 0 );
                sSystemMessage = NumberToString ( MetaDataMinorErrorCount ) | ' metadata error/s';
            ENDIF;
            sSystemMessage= sSystemMessage ;
        ENDIF;
    ENDIF;

    ExecuteProcess('syTITracker',
                   'pProcessName', GetProcessName,
                   'pTime', nStartTime ,
                   'pStatus', 0,
                   'pTM1User', sUserName,
                   'pSystemMessage', sSystemMessage,
                   'pRecordCount', nRecordCountData + nRecordCountMetadata,
                   'pPrologMinorErrorCount', PrologMinorErrorCount,
                   'pMetaDataMinorErrorCount', MetaDataMinorErrorCount,
                   'pDataMinorErrorCount', DataMinorErrorCount,
                   'pDebug', 1 );
ENDIF;
#EndRegion
#endregion